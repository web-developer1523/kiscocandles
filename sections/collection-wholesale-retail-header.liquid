{%- assign is_wholesale = false -%}
{%- if customer and customer.tags contains 'wholesale' -%}
  {%- assign is_wholesale = true -%}
{%- endif -%}

{%- liquid
  assign show_collection_image = section.settings.show_collection_image
  assign collection_image = blank

  if show_collection_image and collection.handle != 'vendors' and collection.handle != 'all'
    if collection.image != blank
      assign collection_image = collection.image
    endif
    if section.settings.image != blank
      assign collection_image = section.settings.image
    endif
    if collection.metafields.custom.header_image.value != blank and section.settings.image == blank
      assign collection_image = collection.metafields.custom.header_image.value
    endif
  endif

  if is_wholesale
    if section.settings.wholesale_heading != blank
      assign banner_title = section.settings.wholesale_heading
    else
      assign banner_title = collection.title
    endif

    if section.settings.wholesale_description != blank
      assign banner_description = section.settings.wholesale_description
    elsif section.settings.show_collection_description
      assign banner_description = collection.description
    else
      assign banner_description = blank
    endif
  else
    assign banner_title = collection.title
    if section.settings.show_collection_description
      assign banner_description = collection.description
    else
      assign banner_description = blank
    endif
  endif

  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
  assign text_position = section.settings.text_position | split: '_'
  assign horizontal_position = text_position | first
  assign vertical_position = text_position | last

  assign text_position_modifier = 'center'
  if horizontal_position == 'flex-start'
    assign text_position_modifier = 'left'
  elsif horizontal_position == 'flex-end'
    assign text_position_modifier = 'right'
  endif

  assign text_position_mobile = section.settings.text_position_mobile | split: '_'
  assign horizontal_position_mobile = text_position_mobile | first
  assign vertical_position_mobile = text_position_mobile | last

  assign text_position_modifier_mobile = 'center'
  if horizontal_position_mobile == 'flex-start'
    assign text_position_modifier_mobile = 'left'
  elsif horizontal_position_mobile == 'flex-end'
    assign text_position_modifier_mobile = 'right'
  endif

  assign placeholder_aspect_ratio = 'no-ratio'
  if section.settings.image_aspect == 'original'
    assign placeholder_aspect_ratio = 'square'
  endif

  assign wholesale_apply_url = section.settings.wholesale_apply_url | default: '/pages/wholesale-signup'
-%}

<header
  class="
    section
    section--full-width
    collection-banner
    cwrr-header
    {% if is_wholesale %}cwrr-header--wholesale{% else %}cwrr-header--retail{% endif %}
    collection-banner--image-aspect-{{ section.settings.image_aspect }}
    collection-banner--text-{{ text_position_modifier }}
    collection-banner--text-mobile-{{ text_position_modifier_mobile }}
    {%- if collection_image != blank -%}
      collection--has-image
      {{ section.settings.section_padding }}
    {%- endif -%}
    {%- if section.settings.show_breadcrumbs -%}
      collection--has-breadcrumbs
    {%- endif -%}
    {% if settings.enable_section_animations and section.settings.enable_animation %}
      animation
      animation--collection-banner
    {% endif %}
  "
  data-section-id="{{ section.id }}"
  data-section-type="collection-banner"
  data-handle="{{ collection.handle }}"
  data-cwrr-layout="{% if is_wholesale %}wholesale{% else %}retail{% endif %}"
  style="
    --custom-height: {{ section.settings.desktop_height }}vh;
    --custom-height-mobile: 30vh;
    --text-horizontal-position: {{ horizontal_position }};
    --text-vertical-position: {{ vertical_position }};
    --text-horizontal-position-mobile: {{ horizontal_position_mobile }};
    --text-vertical-position-mobile: {{ vertical_position_mobile }};
    {% if collection_image != blank -%}
      --color-text: {{ section.settings.text_color }};
      --color-text-link: {{ section.settings.text_color }};
    {% endif %}
    --overlay-background: {{ section.settings.color_overlay }};
    {% if section.settings.color_overlay_gradient != blank %}
      --overlay-background-gradient: {{ section.settings.color_overlay_gradient }};
    {% endif %}
    --overlay-opacity: {{ overlay_opacity }};
  "
>
  {% if section.settings.show_breadcrumbs and collection_image == blank %}
    <div class="collection-banner__breadcrumbs">
      {% render 'breadcrumbs', show_breadcrumbs: section.settings.show_breadcrumbs %}
    </div>
  {% endif %}

  <div class="collection-banner__inner">
    {%- if collection_image != blank -%}
      <div class="collection-banner__image-container">
        {%-
          render 'image' with
          wrapper_class: 'collection-banner__image',
          image: collection_image,
          sizes: '100vw',
          focal_point: section.settings.focal_point,
          include_placeholder: false,
          placeholder_natural_fallback_ratio: placeholder_aspect_ratio,
          animate: true,
          prioritize_loading: true
        -%}
      </div>
      <div class="collection-banner__overlay"></div>
    {%- endif -%}

    <div class="collection-banner__text-container-wrapper">
      <div class="collection-banner__text-container">
        <div class="collection-banner__text-container-inner section-blocks animation--section-blocks">
          {%- if is_wholesale and section.settings.show_wholesale_badge -%}
            <span class="cwrr-header__badge">Wholesale Account</span>
          {%- endif -%}

          <h1 class="collection-banner__text-container-heading ff-heading fs-heading-2-base fs-heading-1-base-ns section-blocks__heading">
            {{ banner_title }}
          </h1>

          {%- if is_wholesale -%}
            {%- if section.settings.wholesale_subheading != blank -%}
              <p class="cwrr-header__subheading">{{ section.settings.wholesale_subheading }}</p>
            {%- endif -%}
            <ul class="cwrr-header__perks">
              {%- if section.settings.perk_1 != blank -%}
                <li>{{ section.settings.perk_1 }}</li>
              {%- endif -%}
              {%- if section.settings.perk_2 != blank -%}
                <li>{{ section.settings.perk_2 }}</li>
              {%- endif -%}
            </ul>
          {%- endif -%}
        </div>
      </div>
    </div>

    {% if section.settings.show_breadcrumbs and collection_image != blank %}
      <div class="collection-banner__breadcrumbs">
        {% render 'breadcrumbs', show_breadcrumbs: section.settings.show_breadcrumbs %}
      </div>
    {% endif %}
  </div>

  {%- if banner_description != blank -%}
    <div class="collection-banner__text-container-text rte ff-body section-blocks__text cwrr-header__description">
      {{ banner_description }}
    </div>
  {%- endif -%}

  {%- unless is_wholesale -%}
    {%- unless customer -%}
      <div class="cwrr-header__info-box" data-spark="b2c-only">
        <p>
          Already have an account?
          <a href="{{ routes.account_login_url }}" class="cwrr-header__link">Log in for member pricing</a>
        </p>
      </div>
    {%- endunless -%}

    {%- if wholesale_apply_url != blank -%}
      <div class="cwrr-header__cta-box" data-spark="b2c-only">
        <p class="cwrr-header__cta-text">Are you a business? Apply for wholesale access</p>
        <a href="{{ wholesale_apply_url }}" class="btn btn--secondary btn--medium">Apply now</a>
      </div>
    {%- endif -%}
  {%- endunless -%}
</header>

<style>
  .cwrr-header__badge {
    display: inline-block;
    margin-bottom: 0.75rem;
    padding: 0.35em 0.85em;
    font-size: var(--font-size-body-50);
    font-weight: var(--font-body-bold-weight);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background-color: var(--color-background-button);
    color: var(--color-text-button);
    border-radius: 3px;
  }

  .cwrr-header__subheading {
    margin: 0.5rem 0 0;
    font-size: var(--font-size-body-100);
    color: inherit;
    opacity: 0.95;
  }

  .cwrr-header__perks {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    font-size: var(--font-size-body-75);
  }

  .cwrr-header__perks li {
    position: relative;
    padding: 0.25rem 0 0.25rem 1.25rem;
  }

  .cwrr-header__perks li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55rem;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background-color: var(--color-background-button);
  }

  .cwrr-header__description {
    max-width: var(--max-width);
    margin-left: auto;
    margin-right: auto;
    padding-left: var(--space-outer, 24px);
    padding-right: var(--space-outer, 24px);
  }

  .cwrr-header__info-box,
  .cwrr-header__cta-box {
    max-width: var(--max-width);
    margin: 1rem auto 0;
    padding: 1rem var(--space-outer, 24px);
  }

  .cwrr-header__info-box {
    font-size: var(--font-size-body-75);
    color: var(--color-text-meta);
    background-color: var(--color-background-meta);
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }

  .cwrr-header__info-box p {
    margin: 0;
  }

  .cwrr-header__link {
    color: var(--color-text-link);
    text-decoration: underline;
  }

  .cwrr-header__cta-box {
    text-align: center;
    background-color: var(--color-background-meta);
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }

  .cwrr-header__cta-text {
    margin: 0 0 0.75rem;
    font-size: var(--font-size-body-100);
    font-weight: var(--font-body-bold-weight);
    color: var(--color-text);
  }
</style>

{% schema %}
{
  "name": "Wholesale Retail Header",
  "tag": "section",
  "class": "collection-section cwrr-header-section",
  "limit": 1,
  "templates": ["collection"],
  "settings": [
    {
      "type": "paragraph",
      "content": "Wholesale customers see wholesale heading, description, and perks. Everyone else sees the collection title and description. Product pricing in the grid is handled by SparkLayer."
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "header",
      "content": "Wholesale banner content"
    },
    {
      "type": "checkbox",
      "id": "show_wholesale_badge",
      "label": "Show wholesale account badge",
      "default": true
    },
    {
      "type": "text",
      "id": "wholesale_heading",
      "label": "Wholesale heading override",
      "info": "Leave blank to use the collection title."
    },
    {
      "type": "richtext",
      "id": "wholesale_description",
      "label": "Wholesale description override",
      "info": "Leave blank to use the collection description."
    },
    {
      "type": "text",
      "id": "wholesale_subheading",
      "label": "Wholesale subheading",
      "default": "Your wholesale pricing is applied at checkout."
    },
    {
      "type": "text",
      "id": "perk_1",
      "label": "Wholesale perk 1",
      "default": "Volume pricing on every product"
    },
    {
      "type": "text",
      "id": "perk_2",
      "label": "Wholesale perk 2",
      "default": "Fast reordering from your account"
    },
    {
      "type": "header",
      "content": "Retail banner content"
    },
    {
      "type": "url",
      "id": "wholesale_apply_url",
      "label": "Wholesale application URL",
      "info": "Shown to guests and retail customers only."
    },
    {
      "type": "header",
      "content": "Banner image"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "label": "Show collection image",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image override"
    },
    {
      "type": "radio",
      "id": "image_aspect",
      "label": "Image aspect",
      "options": [
        { "value": "original", "label": "Original" },
        { "value": "custom", "label": "Custom height" }
      ],
      "default": "custom"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height",
      "unit": "%",
      "min": 30,
      "max": 100,
      "step": 5,
      "default": 30
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "unit": "%",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 50
    },
    {
      "type": "select",
      "id": "focal_point",
      "label": "Focal point",
      "options": [
        { "label": "Image presentation", "value": "image_presentation" },
        { "label": "Center", "value": "center" },
        { "label": "Top", "value": "top" },
        { "label": "Bottom", "value": "bottom" },
        { "label": "Left", "value": "left" },
        { "label": "Right", "value": "right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position",
      "options": [
        { "label": "Top left", "value": "flex-start_flex-start" },
        { "label": "Top center", "value": "center_flex-start" },
        { "label": "Top right", "value": "flex-end_flex-start" },
        { "label": "Middle left", "value": "flex-start_center" },
        { "label": "Middle center", "value": "center_center" },
        { "label": "Middle right", "value": "flex-end_center" },
        { "label": "Bottom left", "value": "flex-start_flex-end" },
        { "label": "Bottom center", "value": "center_flex-end" },
        { "label": "Bottom right", "value": "flex-end_flex-end" }
      ],
      "default": "center_center"
    },
    {
      "type": "select",
      "id": "text_position_mobile",
      "label": "Text position (mobile)",
      "options": [
        { "label": "Top left", "value": "flex-start_flex-start" },
        { "label": "Top center", "value": "center_flex-start" },
        { "label": "Top right", "value": "flex-end_flex-start" },
        { "label": "Middle left", "value": "flex-start_center" },
        { "label": "Middle center", "value": "center_center" },
        { "label": "Middle right", "value": "flex-end_center" },
        { "label": "Bottom left", "value": "flex-start_flex-end" },
        { "label": "Bottom center", "value": "center_flex-end" },
        { "label": "Bottom right", "value": "flex-end_flex-end" }
      ],
      "default": "center_flex-end"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_overlay",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "color_background",
      "id": "color_overlay_gradient",
      "label": "Overlay gradient"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "unit": "%",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 60
    },
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "Enable animation",
      "default": true
    },
    {
      "type": "select",
      "id": "section_padding",
      "label": "Section padding",
      "default": "section--vertical-padding-bottom-only",
      "options": [
        { "label": "None", "value": "section--vertical-padding-none" },
        { "label": "Top and bottom", "value": "section--vertical-padding-top-bottom" },
        { "label": "Top only", "value": "section--vertical-padding-top-only" },
        { "label": "Bottom only", "value": "section--vertical-padding-bottom-only" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wholesale Retail Header"
    }
  ]
}
{% endschema %}
