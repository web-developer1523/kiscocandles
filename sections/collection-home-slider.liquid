<div class="
    collection-list-slider
    section
    {{ section.settings.class }}
    section--divider-{{ section.settings.divider_style }}
    {{ section.settings.section_padding }}
    {% if settings.enable_section_animations and section.settings.enable_animation %}
      animation
      animation--list-slider
    {% endif %}
  " data-section-id="{{ section.id }}" data-section-type="collection-list-slider"
  data-products-per-view="{{ section.settings.columns }}"
  data-mobile-products-per-view="{{ section.settings.mobile_columns }}">
  <div class="collection-list-slider__inner">
    <div class="collection-list-slider__meta carousel__navigation-wrapper home-collection-sl">
      <div class="section-introduction animation--section-introduction ">
        {%- unless section.settings.heading == blank -%}
        <{{ section.settings.heading_tag }}
          class="collection-list-slider__heading ff-heading fs-heading-3-base section-introduction__heading">
          {{ section.settings.heading }}
        </{{ section.settings.heading_tag }}>
        {%- endunless -%}

        {%- unless section.settings.subheading == blank -%}
        <div class="collection-list-slider__subheading ff-body fs-body-100 rte section-introduction__subheading">
          {{ section.settings.subheading }}
        </div>
        {%- endunless -%}

        {%- render 'button-block' with
        wrapper_class: "collection-list-slider__button section-introduction__button",
        link: section.settings.link,
        label: section.settings.link_text,
        button_style: "btn--callout"
        -%}
      </div>

      {%- render 'carousel-navigation' with wrapper_class: 'animation--controls' %}
    </div>

    <div class="
        collection-list-slider__content
        carousel
        carousel--mobile-per-view-{{ section.settings.mobile_columns }}
        carousel--per-view-{{ section.settings.columns }}
        swiper
      ">
      <div class="collection-list-slider__collections carousel__wrapper swiper-wrapper">
        <!-- Hardcoded blocks start here -->
          <div class="collection-list-slider__collection carousel__slide swiper-slide">
    <div class="collection-item">
      {%- if custom_title == 'Wholesale for Businesses' -%}
        <!-- Image link specifically for Wholesale for Businesses -->
        <a href="https://kiscocandles.com/pages/wholesale" class="collection-item__image-wrapper hover" aria-label="Wholesale for Businesses">
          <img src="path/to/image1.jpg" alt="Wholesale for Businesses" class="collection-item__image">
        </a>
        <div class="collection-item__label">Wholesale for Businesses</div>
      {%- endif -%}
    </div>
  </div>

  <!-- Other collection blocks -->
  {%- if custom_title != 'Wholesale for Businesses' -%}
    <div class="collection-list-slider__collection carousel__slide swiper-slide">
      <div class="collection-item">
        <a href="{{ collection.url }}" class="collection-item__image-wrapper hover" aria-label="{{ collection.title }}">
          <img src="{{ collection.image.src }}" alt="{{ collection.title }}" class="collection-item__image">
        </a>
        <div class="collection-item__label">{{ collection.title }}</div>
      </div>
    </div>
  {%- endif -%}
        <div class="collection-list-slider__collection carousel__slide swiper-slide">
          <div class="collection-item">
            <img src="https://cdn.shopify.com/s/files/1/0552/6267/5053/files/bulk-candles.jpg?v=1720034677" alt="Image 2" class="collection-item__image">
            <div class="collection-item__label">Individuals</div>
          </div>
        </div>
        <div class="collection-list-slider__collection carousel__slide swiper-slide">
          <div class="collection-item">
            <img src="path/to/image3.jpg" alt="Image 3" class="collection-item__image">
            <div class="collection-item__label">Weddings & Events</div>
          </div>
        </div>
        <div class="collection-list-slider__collection carousel__slide swiper-slide">
          <div class="collection-item">
            <img src="path/to/image4.jpg" alt="Image 4" class="collection-item__image">
            <div class="collection-item__label">Decorative</div>
          </div>
        </div>
        <!-- Hardcoded blocks end here -->
      </div>
    </div>
  </div>
</div>

{% schema %}
{
"name": "t:sections.collection_list_slider.name",
"tag": "section",
"disabled_on": {
"groups": ["header", "custom.overlay"],
"templates": ["password"]
},
"settings": [
{
"type": "text",
"id": "class",
"label": "class"
},
{
"type": "text",
"id": "heading",
"label": "t:sections.collection_sections_shared.settings.title.label",
"default": "Collection list"
},
{
"id": "heading_tag",
"type": "select",
"label": "t:shared.section_blocks.heading.settings.heading_tag.label",
"default": "h2",
"options": [
{
"value": "h2",
"label": "t:shared.section_blocks.heading.settings.heading_tag.options.h2"
},
{
"value": "h3",
"label": "t:shared.section_blocks.heading.settings.heading_tag.options.h3"
},
{
"value": "h4",
"label": "t:shared.section_blocks.heading.settings.heading_tag.options.h4"
},
{
"value": "h5",
"label": "t:shared.section_blocks.heading.settings.heading_tag.options.h5"
},
{
"value": "h6",
"label": "t:shared.section_blocks.heading.settings.heading_tag.options.h6"
}
]
},
{
"type": "paragraph",
"content": "t:shared.section_blocks.heading.settings.heading_tag.info"
},
{
"type": "richtext",
"id": "subheading",
"label": "t:sections.collection_sections_shared.settings.subheading.label"
},
{
"id": "link",
"type": "url",
"label": "t:shared.settings.button_link.label",
"default": "/collections"
},
{
"id": "link_text",
"type": "text",
"label": "t:shared.settings.button_link_text.label",
"default": "View all collections"
},
{
"type": "header",
"content": "t:sections.collection_sections_shared.settings.header_collection_list.content"
},
{
"type": "select",
"id": "columns",
"label": "t:shared.settings.column_count.desktop.label",
"default": "4",
"options": [
{
"value": "3",
"label": "t:shared.settings.column_count.columns.option_3"
},
{
"value": "4",
"label": "t:shared.settings.column_count.columns.option_4"
},
{
"value": "5",
"label": "t:shared.settings.column_count.columns.option_5"
}
]
},
{
"type": "select",
"id": "mobile_columns",
"label": "t:shared.settings.column_count.mobile.label",
"default": "2",
"options": [
{
"value": "1",
"label": "t:shared.settings.column_count.columns.option_1"
},
{
"value": "2",
"label": "t:shared.settings.column_count.columns.option_2"
}
]
},
{
"id": "collection_list",
"type": "collection_list",
"label": "t:sections.collection_sections_shared.settings.collection_list.label"
},
{
"type": "header",
"content": "t:shared.settings.collection_listing.header_collection_listing.content"
},
{
"type": "select",
"id": "collection_listing_aspect_ratio",
"label": "t:shared.settings.collection_listing.collection_listing_aspect_ratio.label",
"default": "square",
"options": [
{
"value": "natural",
"label": "t:shared.settings.aspect_ratio.option_natural"
},
{
"value": "square",
"label": "t:shared.settings.aspect_ratio.option_square"
},
{
"value": "portrait",
"label": "t:shared.settings.aspect_ratio.option_portrait"
},
{
"value": "landscape",
"label": "t:shared.settings.aspect_ratio.option_landscape"
}
]
},
{
"type": "select",
"id": "label_style",
"label": "t:shared.settings.collection_listing.label_style.label",
"default": "overlay",
"options": [
{
"value": "overlay",
"label": "t:shared.settings.collection_listing.label_style.option_overlay"
},
{
"value": "beneath",
"label": "t:shared.settings.collection_listing.label_style.option_beneath"
}
]
},
{
"type": "select",
"id": "overlay_title_background_style",
"label": "t:shared.settings.collection_listing.overlay_title_background_style.label",
"default": "gradient",
"options": [
{
"value": "solid",
"label": "t:shared.settings.collection_listing.overlay_title_background_style.option_solid"
},
{
"value": "gradient",
"label": "t:shared.settings.collection_listing.overlay_title_background_style.option_gradient"
}
]
},
{
"type": "color",
"id": "overlay_text_color",
"label": "t:shared.settings.collection_listing.overlay_text_color.label",
"default": "#fff"
},
{
"type": "color",
"id": "overlay_title_background",
"label": "t:shared.settings.collection_listing.overlay_title_background.label",
"default": "#000000"
},
{
"type": "header",
"content": "t:shared.settings.section_style.header_style.content"
},
{
"id": "enable_animation",
"type": "checkbox",
"label": "t:shared.settings.section_style.enable_animation.label",
