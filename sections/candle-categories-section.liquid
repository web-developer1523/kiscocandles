<style>
.custom-categories {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 80px;
  padding: 20px;
  text-align: center;
}

.custom-category {
  flex: 0 1 200px;
  max-width: 200px;
  margin: 0;
}

.custom-category img {
  width: 100%;
  aspect-ratio: 1 / 1;
  object-fit: cover;
  border-radius: 50%;
  border: 2px solid #e0e0e0;
  padding: 6px;
  background-color: #f5f5f5;
}

.custom-category a {
  text-decoration: none;
  color: #333;
  font-weight: bold;
  font-size: 14px;
  display: block;
  margin-top: 10px;
  white-space: nowrap;
  overflow: hidden;
}

.custom-category a:hover {
  color: #007bff;
}

/* Smaller two-column layout for mobile */
@media (max-width: 768px) {
  .custom-category {
    flex: 0 0 calc(50% - 16px);
    max-width: calc(50% - 16px);
  }

  .custom-category img {
    width: 50%;
    padding: 4px;
    border-width: 1px;
  }

  .custom-category a {
    font-size: 13px;
  }

  .custom-categories {
    gap: 16px;
    padding: 10px;
  }
}

/* Even smaller layout */
@media (max-width: 400px) {
  .custom-category {
    flex: 0 0 calc(50% - 10px);
    max-width: calc(50% - 10px);
  }

  .custom-category a {
    font-size: 10px;
  }

  .custom-category img {
    width: 50%;
    padding: 2px;
  }

  .custom-categories {
    gap: 10px;
    padding: 8px;
  }
}

{{ section.settings.custom_css }}
</style>

<div class="custom-categories">
  {% if section.settings.section_title != blank %}
    <h2>{{ section.settings.section_title }}</h2>
  {% endif %}
  {% for block in section.blocks %}
    <div class="custom-category">
      {% if block.settings.category_image %}
        <a href="{{ block.settings.category_collection.url }}">
          <img
            src="{{ block.settings.category_image | img_url: '480x480' }}"
            alt="{{ block.settings.category_image_alt | default: block.settings.category_name | escape }}">
        </a>
      {% endif %}
      <a href="{{ block.settings.category_collection.url }}">{{ block.settings.category_name }}</a>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Custom Categories",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Our Categories"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS",
      "info": "Add custom styles to the section only.",
      "default": "h2 {\n  font-size: 32px;\n}"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "category_name",
          "label": "Category Name",
          "default": "Category"
        },
        {
          "type": "image_picker",
          "id": "category_image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "category_image_alt",
          "label": "Image Alt Text",
          "info": "Custom alt text for the image. Improves SEO and accessibility."
        },
        {
          "type": "collection",
          "id": "category_collection",
          "label": "Category Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Categories",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
