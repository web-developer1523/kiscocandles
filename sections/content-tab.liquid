{%- for block in section.blocks -%}
  {%- capture navigation_list_items -%}
    {{ navigation_list_items }}
    <li>
      <button
        type="button"
        class="tab_content_btn {% if forloop.first %} selected{% endif %}"
        data-tab-item="{{ forloop.index }}"
      >
        <span class="ff-body fs-body-150">{{ block.settings.title }}</span>
      </button>
    </li>
  {%- endcapture -%}

  {%- capture tab_elements -%}
    {%- assign titleDn = block.settings.title | downcase -%}
    {{ tab_elements }}
    <div
      class="tab_content_data-{{ forloop.index }} tab_content_class{% unless forloop.first %} hide{% endunless %}"
      {{ block.shopify_attributes }}
    >
      <div class="tab__content-data">
        {%- if titleDn == 'description' -%}
          {{ product.description }}
        {%- else -%}
        {%- unless block.settings.page_content == blank -%}
          {{ pages[block.settings.page_content].content }}
        {%- else -%}
          {{ block.settings.content }}
        {%- endunless -%}

        {%- if block.settings.text_1 != blank or block.settings.text_2 != blank or block.settings.text_3 != blank or block.settings.text_4 != blank or block.settings.text_5 != blank or block.settings.text_6 != blank -%}
          <div
            class="product__block product__block-callouts product__callouts product__block--medium"
            {{ block.shopify_attributes }}
          >
          <div
            class="product__callouts-items{% if block.settings.custom_class != blank %} {{ block.settings.custom_class }}{% endif %}"
            data-with-box="true"
            data-with-dividers="true"
          >
            {%- if block.settings.text_1 != blank -%}
              {%- assign text1 = block.settings.text_1 | strip_html -%}
              {%
                render 'product-block-callouts-item' with
                text_heading: block.settings.text_heading1,
                text: text1,
                icon: block.settings.icon_1,
                custom_icon_image: block.settings.custom_icon_image_1
              %}
            {%- endif -%}
            {%- if block.settings.text_2 != blank -%}
              {%- assign text2 = block.settings.text_2 | strip_html -%}
              {%
                render 'product-block-callouts-item' with
                text_heading: block.settings.text_heading2,
                text: text2,
                icon: block.settings.icon_2,
                custom_icon_image: block.settings.custom_icon_image_2
              %}
            {%- endif -%}

            
            {%- if block.settings.text_3 != blank -%}
              {%- assign text3 = block.settings.text_3 | strip_html -%}
              {%
                render 'product-block-callouts-item' with
                text_heading: block.settings.text_heading3,
                text: text3,
                icon: block.settings.icon_3,
                custom_icon_image: block.settings.custom_icon_image_3
              %}
            {%- endif -%}
            {%- if block.settings.text_4 != blank -%}
              {%- assign text4 = block.settings.text_4 | strip_html -%}
              {%
                render 'product-block-callouts-item' with
                text_heading: block.settings.text_heading4,
                text: text4,
                icon: block.settings.icon_4,
                custom_icon_image: block.settings.custom_icon_image_4
              %}
            {%- endif -%}
            {%- if block.settings.text_5 != blank -%}
              {%- assign text5 = block.settings.text_5 | strip_html -%}
              {%
                render 'product-block-callouts-item' with
                text_heading: block.settings.text_heading5,
                text: text5,
                icon: block.settings.icon_5,
                custom_icon_image: block.settings.custom_icon_image_5
              %}
            {%- endif -%}
            {%- if block.settings.text_6 != blank -%}
              {%- assign text6 = block.settings.text_6 | strip_html -%}
              {%
                render 'product-block-callouts-item' with
                text_heading: block.settings.text_heading6,
                text: text6,
                icon: block.settings.icon_6,
                custom_icon_image: block.settings.custom_icon_image_6
              %}
            {%- endif -%}
          </div>
          </div>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  {%- endcapture -%}
{%- endfor -%}


<div
  class="
    featured-collection-slider
    featured-collection-slider--mobile-per-view-{{ section.settings.mobile_columns }}
    featured-collection-slider--per-view-{{ section.settings.mobile_columns }}
    section
    section--includes-product-items
    section--divider-{{ section.settings.divider_style }}
    {{ section.settings.section_padding }}
    {% if settings.enable_section_animations and section.settings.enable_animation %}
      animation
      animation--list-slider
    {% endif %}
  "
  data-section-id="{{ section.id }}"
  data-section-type="featured-collection-slider"
  data-products-per-view="{{ section.settings.columns }}"
  data-mobile-products-per-view="{{ section.settings.mobile_columns }}"
>
  <div class="featured-collection-slider__inner">
    <div class="featured-collection-slider__meta{% if section.blocks.size == 1 %} carousel__navigation-wrapper{% endif %}">
      <div class="featured-collection-slider__meta-controls">
          <ul class="featured-collection-slider__navigation-list animation--controls">
            {{ navigation_list_items }}
          </ul>
        </div>
    </div>
    {{ tab_elements }}
  </div>
</div>

