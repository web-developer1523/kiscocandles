<script>
  {% # This is done here AND in the JS so it's responsive in the theme editor before the JS is loaded %}
  document.documentElement.setAttribute("data-enable-sticky-announcement-bar", "{{ section.settings.enable_sticky_announcement_bar }}");
</script>
{% if section.settings.enable_sticky_announcement_bar == 'never' %}
  <style>
    [data-enable-sticky-announcement-bar="never"] .announcement-bar__outer-wrapper,
    [data-enable-sticky-announcement-bar="never"] .announcement-bar {
      position: relative !important;
      top: auto !important;
      z-index: auto !important;
    }
    html.sticky-header-enabled[data-enable-sticky-announcement-bar="never"] .shopify-section.header__outer-wrapper {
      top: 0 !important;
    }
    [data-enable-sticky-announcement-bar="never"] {
      --announcement-height: 0 !important;
    }
  </style>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const announcementWrapper = document.querySelector(".announcement-bar__outer-wrapper");
      const headerWrapper = document.querySelector(".header__outer-wrapper");
      if (announcementWrapper) {
        announcementWrapper.style.position = "relative";
        announcementWrapper.style.top = "auto";
        announcementWrapper.style.zIndex = "auto";
      }
      if (headerWrapper) {
        headerWrapper.style.top = "0px";
      }
      document.documentElement.style.setProperty("--announcement-height", "0px");
    });
  </script>
{% endif %}
{%- if section.blocks.size -%}
  {%- capture items -%}
    {%- for block in section.blocks -%}
      <div
        class="announcement-bar__item ff-body fs-body-50 swiper-slide"
        {% unless forloop.first %}
          inert
        {% endunless %}
        data-slide
        {{ block.shopify_attributes }}
        data-index="{{ forloop.index0 }}"
      >
        {%- assign has_mobile_text = false -%}
        {%- if block.settings.title_mobile != blank and block.settings.title_mobile != block.settings.title -%}
          {%- assign has_mobile_text = true -%}
          <div class="announcement-bar__item-inner announcement-bar__item-inner-mobile-only">
            {%- if block.settings.link != blank -%}
              <a class="announcement-bar__link color-inherit" href="{{ block.settings.link }}">
                {{ block.settings.title_mobile | replace: '<a ', '<span class="fake-link" ' | replace: '</a>', '</span>' }}
              </a>
            {%- else -%}
              {{ block.settings.title_mobile }}
            {%- endif -%}
          </div>
        {%- endif -%}
        <div class="announcement-bar__item-inner{% if has_mobile_text %} announcement-bar__item-inner-desktop-only{% endif %}">
          {%- if block.settings.link != blank -%}
            <a class="announcement-bar__link color-inherit" href="{{ block.settings.link }}">
              {{ block.settings.title | replace: '<a ', '<span class="fake-link" ' | replace: '</a>', '</span>' }}
            </a>
          {%- else -%}
            {{ block.settings.title }}
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  {%- endcapture -%}
  <div class="topbar-header">
    <div class="header__inner">
       <div class="topbar-sec">
        <div class="topbar-left">{% render 'social-icons' %}</div>
        <div class="topbar-middle">
          
        <div
          {% if section.blocks.size == 0 %}
            hidden
          {% endif %}
          class="announcement-bar{% if section.blocks.size == 0 %} hidden{% endif %}"
          data-section-id="{{ section.id }}"
          data-section-type="announcement-bar"
          data-enable-sticky-announcement-bar="{{ section.settings.enable_sticky_announcement_bar }}"
          data-item-count="{{ section.blocks.size }}"
          style="
            --color-background: {{ section.settings.color_background }};
            --color-gradient-overlay: {{ section.settings.color_background | color_modify: 'alpha', 1 }};
            --color-gradient-overlay-transparent: {{ section.settings.color_background | color_modify: 'alpha', 0 }};
            --color-text: {{ section.settings.color_text }};
          "
        >
          <div class="ui-overlap-wrap">
            <div class="ui-overlap">
              <div class="fader left">
                <button class="slider-nav-button slider-nav-button-prev" title="{{ 'general.accessibility.previous' | t }}">
                  {% render 'icon' with icon: 'chevron' %}
                </button>
              </div>
              <div class="ui-overlap-item-clones" aria-hidden="true">
                {{ items }}
              </div>
              <div class="fader right">
                <button class="slider-nav-button slider-nav-button-next" title="{{ 'general.accessibility.next' | t }}">
                  {% render 'icon' with icon: 'chevron' %}
                </button>
              </div>
            </div>
          </div>
          <div
            class="swiper"
            data-slider
            data-autoplay-enabled="{{ section.settings.autoplay_enabled }}"
            data-autoplay-delay="{{ section.settings.autoplay_delay | times: 1000 }}"
          >
            <div class="swiper-wrapper">
              {{ items }}

             
            </div>

               
          </div>
        </div>
       </div>   
         

       <div class="toplink">

         <!-- shopper approved seal sections/announcment-bar.liquid -->
                   <style>

                     @media screen and (max-width: 576px) {
                       a.new-sa-seals {
                        text-align: center;
                        display: block;
                        vertical-align: middle;
                        top:-11px;
                        position:relative;
                      }
                       
                    }
                     .topbar-header .topbar-sec .topbar-left, .topbar-header .topbar-sec .toplink {
                        width: 445px;
                       }
                    </style>
                   <a href="https://www.shopperapproved.com/reviews/kiscocandles.com" class="shopperlink new-sa-seals placement-1984"><img src="//www.shopperapproved.com/seal/40737/1984-sa-seal.gif" style="border-radius: 4px;top: 4px;left:-18px; position: relative;" alt="Customer Reviews" oncontextmenu="var d = new Date(); alert('Copying Prohibited by Law - This image and all included logos are copyrighted by Shopper Approved \251 '+d.getFullYear()+'.'); return false;" /></a><script type="text/javascript"> (function() { var js = window.document.createElement("script"); js.innerHTML = 'function openshopperapproved(o){ var e="Microsoft Internet Explorer"!=navigator.appName?"yes":"no",n=screen.availHeight-90,r=940;return window.innerWidth<1400&&(r=620),window.open(this.href,"shopperapproved","location="+e+",scrollbars=yes,width="+r+",height="+n+",menubar=no,toolbar=no"),o.stopPropagation&&o.stopPropagation(),!1}!function(){for(var o=document.getElementsByClassName("shopperlink"),e=0,n=o.length;e<n;e++)o[e].onclick=openshopperapproved}();'; js.type = "text/javascript"; document.getElementsByTagName("head")[0].appendChild(js);var link = document.createElement('link');link.rel = 'stylesheet';link.type = 'text/css';link.href = "//www.shopperapproved.com/seal/1984.css";document.getElementsByTagName('head')[0].appendChild(link);})();</script>
         
         <!-- shopper approved seal sections/announcment-bar.liquid -->
  
          <ul>
             <li><a href="/pages/about">About Us</a></li>
              <li><a href="/pages/contact-us">Contact Us</a></li>
              <li><a href="/pages/faq">FAQ</a></li>
               </ul>
      </div>
     </div>    
  </div>
</div>  
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "class": "announcement-bar__outer-wrapper",
  "max_blocks": 3,
  "settings": [
    {
      "id": "enable_sticky_announcement_bar",
      "type": "select",
      "label": "t:sections.announcement_bar.settings.enable_sticky_announcement_bar.label",
      "info": "t:sections.announcement_bar.settings.enable_sticky_announcement_bar.info",
      "options": [
        {
          "value": "never",
          "label": "t:sections.announcement_bar.settings.enable_sticky_announcement_bar.options.never"
        },
        {
          "value": "desktop",
          "label": "t:sections.announcement_bar.settings.enable_sticky_announcement_bar.options.desktop"
        },
        {
          "value": "mobile",
          "label": "t:sections.announcement_bar.settings.enable_sticky_announcement_bar.options.mobile"
        },
        {
          "value": "desktop-and-mobile",
          "label": "t:sections.announcement_bar.settings.enable_sticky_announcement_bar.options.both"
        }
      ],
      "default": "never"
    },
    {
      "id": "autoplay_enabled",
      "type": "checkbox",
      "label": "t:sections.announcement_bar.settings.autoplay_enabled.label",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "t:sections.announcement_bar.settings.timing.label",
      "min": 3,
      "max": 15,
      "step": 1,
      "default": 4,
      "unit": "s"
    },
    {
      "id": "color_background",
      "type": "color",
      "label": "t:sections.announcement_bar.settings.color_background.label",
      "default": "#000000"
    },
    {
      "id": "color_text",
      "type": "color",
      "label": "t:sections.announcement_bar.settings.color_text.label",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement_bar.blocks.announcement.name",
      "settings": [
        {
          "type": "richtext",
          "id": "title",
          "default": "<p>Free standard shipping and returns on all orders</p>",
          "label": "t:sections.announcement_bar.blocks.announcement.settings.title.label"
        },
        {
          "type": "richtext",
          "id": "title_mobile",
          "label": "t:sections.announcement_bar.blocks.announcement.settings.title_mobile.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement_bar.blocks.announcement.settings.link.label",
          "info": "t:sections.announcement_bar.blocks.announcement.settings.link.info"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "announcement"
      }
    ]
  }
}
{% endschema %}
