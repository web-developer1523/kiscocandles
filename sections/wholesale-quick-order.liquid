{{ 'wholesale-dashboard.css' | asset_url | stylesheet_tag }}
{{ 'wholesale-quick-order.css' | asset_url | stylesheet_tag }}
<script src="{{ 'wholesale-dashboard.js' | asset_url }}" defer></script>
<script src="{{ 'wholesale-quick-order.js' | asset_url }}" defer></script>

{%- liquid
  assign is_wholesale = false
  if customer and customer.tags contains 'wholesale'
    assign is_wholesale = true
  endif

  assign first_initial = customer.first_name | slice: 0 | upcase
  assign last_initial = customer.last_name | slice: 0 | upcase
  assign customer_initials = first_initial | append: last_initial

  assign dashboard_url = section.settings.dashboard_page_url
  if dashboard_url == blank
    assign dashboard_url = '/pages/wholesale-dashboard'
  endif
  assign quick_order_url = request.path

  assign product_source = section.settings.product_source
  assign max_products = section.settings.max_products | default: 12
  assign products_shown = 0
  assign use_recommended = false
  if product_source == 'recommended'
    assign use_recommended = true
  endif

  assign recommended_handles = ''
  if use_recommended and customer.orders.size > 0
    for order in customer.orders
      for line_item in order.line_items
        assign handle = line_item.product.handle
        if handle != blank
          assign handle_marker = handle | append: '|'
          unless recommended_handles contains handle_marker
            assign recommended_handles = recommended_handles | append: handle_marker
          endunless
        endif
      endfor
    endfor
  endif

  assign recommended_handles_list = recommended_handles | split: '|'
  assign has_recommended = false
  if recommended_handles != blank
    assign has_recommended = true
  endif
-%}

<section
  class="wholesale-dashboard wholesale-quick-order section"
  data-section-id="{{ section.id }}"
  data-section-type="wholesale-quick-order"
  data-wholesale-dashboard
  data-wholesale-quick-order
>
  <div class="wholesale-dashboard__inner">
    {%- unless is_wholesale -%}
      <div class="wholesale-dashboard__denied">
        <h2 class="wholesale-dashboard__denied-title">Quick Order</h2>
        <p class="wholesale-dashboard__denied-text">
          You need an approved wholesale account to access quick ordering.
        </p>
        <a href="/pages/wholesale" class="wholesale-dashboard__btn" style="width: auto; display: inline-flex;">
          Login
        </a>
      </div>
    {%- else -%}
      <button
        type="button"
        class="wholesale-dashboard__mobile-toggle"
        data-sidebar-toggle
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        Menu
      </button>

      <div class="wholesale-dashboard__overlay" data-sidebar-overlay></div>

      <div class="wholesale-dashboard__layout">
        {%- render 'wholesale-dashboard-sidebar',
          active_page: 'quick-order',
          dashboard_url: dashboard_url,
          quick_order_url: quick_order_url,
          customer: customer,
          customer_initials: customer_initials
        -%}

        <div class="wholesale-dashboard__main">
          <header class="wholesale-dashboard__welcome">
            <h1 class="wholesale-dashboard__welcome-title">
              {{ section.settings.heading | default: 'Quick Order' }}
            </h1>
            <p class="wholesale-dashboard__welcome-subtitle">
              {{ section.settings.subheading | default: 'Add products to your cart in just a few clicks.' }}
            </p>
          </header>

          {%- if section.settings.show_sku_search -%}
            <div class="wholesale-quick-order__sku-panel wholesale-dashboard__panel">
              <h2 class="wholesale-quick-order__sku-title">Order by SKU</h2>
              <p class="wholesale-quick-order__sku-desc">Enter a product SKU to find and add it quickly.</p>
              <form class="wholesale-quick-order__sku-form" data-sku-form>
                <label class="visually-hidden" for="sku-search-{{ section.id }}">SKU</label>
                <input
                  type="search"
                  id="sku-search-{{ section.id }}"
                  class="wholesale-quick-order__sku-input"
                  data-sku-input
                  placeholder="Enter SKU"
                  autocomplete="off"
                >
                <label class="visually-hidden" for="sku-qty-{{ section.id }}">Quantity</label>
                <input
                  type="number"
                  id="sku-qty-{{ section.id }}"
                  class="wholesale-quick-order__qty wholesale-quick-order__sku-qty"
                  data-sku-qty
                  value="1"
                  min="1"
                  step="1"
                  inputmode="numeric"
                  aria-label="SKU quantity"
                >
                <button type="submit" class="wholesale-dashboard__btn wholesale-quick-order__sku-btn" data-sku-submit>
                  Add to cart
                </button>
              </form>
              <p class="wholesale-quick-order__sku-feedback" data-sku-feedback role="status" aria-live="polite"></p>
            </div>
          {%- endif -%}

          <div class="wholesale-quick-order__products-header">
            <h2 class="wholesale-dashboard__section-title wholesale-quick-order__products-heading">
              {%- if use_recommended -%}
                Recommended for you
              {%- else -%}
                Featured products
              {%- endif -%}
            </h2>
            {%- if use_recommended -%}
              <p class="wholesale-quick-order__products-note">Based on your previous orders.</p>
            {%- endif -%}
          </div>

          <div class="wholesale-quick-order__grid" data-quick-order-grid>
            {%- if use_recommended -%}
              {%- if has_recommended -%}
                {%- for handle in recommended_handles_list -%}
                  {%- if handle != blank and products_shown < max_products -%}
                    {%- assign product = all_products[handle] -%}
                    {%- if product != blank -%}
                      {%- render 'wholesale-quick-order-item',
                        product: product,
                        show_reorder_badge: true,
                        section: section
                      -%}
                      {%- assign products_shown = products_shown | plus: 1 -%}
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- elsif section.settings.fallback_to_selected and section.settings.selected_products.size > 0 -%}
                {%- for product in section.settings.selected_products -%}
                  {%- if products_shown < max_products -%}
                    {%- render 'wholesale-quick-order-item',
                      product: product,
                      show_reorder_badge: false,
                      section: section
                    -%}
                    {%- assign products_shown = products_shown | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            {%- else -%}
              {%- for product in section.settings.selected_products -%}
                {%- if products_shown < max_products -%}
                  {%- render 'wholesale-quick-order-item',
                    product: product,
                    show_reorder_badge: false,
                    section: section
                  -%}
                  {%- assign products_shown = products_shown | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </div>

          {%- if products_shown == 0 -%}
            <div class="wholesale-quick-order__empty wholesale-dashboard__panel">
              {%- if use_recommended -%}
                <p>You don't have any previous orders yet. Place your first order to see personalized recommendations here.</p>
                {%- if section.settings.fallback_to_selected == false and section.settings.selected_products.size > 0 -%}
                  <p>Ask your store admin to enable the fallback to featured products setting.</p>
                {%- endif -%}
              {%- else -%}
                <p>No products have been selected yet. Choose products in the theme editor under Quick Order settings.</p>
              {%- endif -%}
              <a href="{{ routes.all_products_collection_url }}" class="wholesale-dashboard__btn" style="width: auto; display: inline-flex; margin-top: 16px;">
                Browse catalog
              </a>
            </div>
          {%- endif -%}

          {%- if products_shown > 0 -%}
            <div class="wholesale-quick-order__footer">
              <a href="{{ routes.cart_url }}" class="wholesale-dashboard__btn wholesale-quick-order__view-cart">
                View cart
              </a>
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endunless -%}
  </div>
</section>

{% schema %}
{
  "name": "Wholesale Quick Order",
  "tag": "section",
  "class": "wholesale-quick-order-section",
  "settings": [
    {
      "type": "header",
      "content": "Page content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Quick Order"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Add products to your cart in just a few clicks."
    },
    {
      "type": "url",
      "id": "dashboard_page_url",
      "label": "Wholesale dashboard page URL",
      "info": "Link back to the wholesale dashboard from the sidebar."
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "select",
      "id": "product_source",
      "label": "Product display mode",
      "info": "Choose whether customers see admin-selected products or items from their order history.",
      "options": [
        {
          "value": "selected",
          "label": "Selected products"
        },
        {
          "value": "recommended",
          "label": "Recommended (previous orders)"
        }
      ],
      "default": "selected"
    },
    {
      "type": "product_list",
      "id": "selected_products",
      "label": "Selected products",
      "limit": 24,
      "info": "Used when display mode is Selected products, or as fallback for recommended mode."
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum products to show",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "fallback_to_selected",
      "label": "Fallback to selected products",
      "info": "When recommended mode is on but the customer has no order history, show selected products instead.",
      "default": true
    },
    {
      "type": "header",
      "content": "SKU search"
    },
    {
      "type": "checkbox",
      "id": "show_sku_search",
      "label": "Show order by SKU bar",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Wholesale Quick Order"
    }
  ]
}
{% endschema %}
