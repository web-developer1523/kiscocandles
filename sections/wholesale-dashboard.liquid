<script>
  (function () {
    var section = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!section) { return; }

    var main = section.querySelector('.wholesale-dashboard__main');
    if (!main) { return; }

    var blocks = Array.prototype.slice.call(main.children);
    var panels = Array.prototype.slice.call(section.querySelectorAll('[data-company-profile-panel], [data-tax-exemption-panel]'));
    var navLinks = section.querySelectorAll('[data-dashboard-nav]');
    if (!navLinks.length) { return; }

    var hashViewMap = {
      '#company-profile': 'company-profile',
      '#tax-exemption': 'tax-exemption',
      '#tax-certificates': 'tax-exemption'
    };

    function showView(viewId) {
      var activePanel = null;

      panels.forEach(function (panel) {
        if (panel.getAttribute('data-company-profile-panel') !== null && viewId === 'company-profile') {
          activePanel = panel;
        }
        if (panel.getAttribute('data-tax-exemption-panel') !== null && viewId === 'tax-exemption') {
          activePanel = panel;
        }
      });

      blocks.forEach(function (el) {
        if (activePanel) {
          if (el === activePanel) {
            el.removeAttribute('hidden');
            el.style.display = '';
          } else {
            el.setAttribute('hidden', '');
            el.style.display = 'none';
          }
        } else if (panels.indexOf(el) === -1) {
          el.removeAttribute('hidden');
          el.style.display = '';
        } else {
          el.setAttribute('hidden', '');
          el.style.display = 'none';
        }
      });

      navLinks.forEach(function (link) {
        var isActive = link.getAttribute('data-dashboard-nav') === viewId;
        link.classList.toggle('is-active', isActive);
        if (isActive) {
          link.setAttribute('aria-current', 'page');
        } else {
          link.removeAttribute('aria-current');
        }
      });

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    navLinks.forEach(function (link) {
      link.addEventListener('click', function (event) {
        event.preventDefault();
        showView(link.getAttribute('data-dashboard-nav'));
      });
    });

    var initialView = hashViewMap[window.location.hash] || 'dashboard';
    showView(initialView);
  })();
</script>

<script>
document.addEventListener("click", function (e) {
    if (e.target.closest(".btn-cross")) {

        document.querySelector(".wholesale-dashboard__sidebar")?.classList.remove("is-open");
        document.querySelector(".wholesale-dashboard__overlay")?.classList.remove("is-visible");

        // Reset body/html scroll
        document.body.style.overflow = "";
        document.documentElement.style.overflow = "";

        document.body.classList.remove("overflow-hidden", "no-scroll", "menu-open");
        document.documentElement.classList.remove("overflow-hidden", "no-scroll", "menu-open");
    }
});
</script>


{% schema %}
{
  "name": "Wholesale Dashboard",
  "tag": "section",
  "class": "wholesale-dashboard-section",
  "settings": [
    {
      "type": "header",
      "content": "Banner"
    },
    {
      "type": "image_picker",
      "id": "wholesale_banner",
      "label": "Wholesale Benefits Banner"
    },
    {
      "type": "header",
      "content": "Customer Since date"
    },
    {
      "type": "text",
      "id": "customer_since_metafield_key",
      "label": "Registration date metafield key (optional)",
      "info": "Helium date column key. If empty, uses first order date or Helium registration event via JavaScript."
    },
    {
      "type": "header",
      "content": "Contact information"
    },
    {
      "type": "text",
