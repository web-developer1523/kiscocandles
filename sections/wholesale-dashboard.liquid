{{ 'wholesale-dashboard.css' | asset_url | stylesheet_tag }}
<script src="{{ 'wholesale-dashboard.js' | asset_url }}" defer></script>

{%- capture company_name -%}
  {%- render 'wholesale-cf-value', customer: customer, field_key: 'company_name' -%}
{%- endcapture -%}
{%- capture business_type -%}
  {%- render 'wholesale-cf-value', customer: customer, field_key: 'business_type' -%}
{%- endcapture -%}
{%- capture customer_phone -%}
  {%- render 'wholesale-cf-value', customer: customer, field_key: 'phone' -%}
{%- endcapture -%}
{%- capture wholesale_status -%}
  {%- render 'wholesale-cf-value', customer: customer, field_key: 'are_you_a_wholesaler' -%}
{%- endcapture -%}

{%- liquid
  assign is_wholesale = false
  if customer and customer.tags contains 'wholesale'
    assign is_wholesale = true
  endif

  assign first_initial = customer.first_name | slice: 0 | upcase
  assign last_initial = customer.last_name | slice: 0 | upcase
  assign customer_initials = first_initial | append: last_initial

  assign company_name = company_name | strip
  assign business_type = business_type | strip
  assign customer_phone = customer_phone | strip
  assign wholesale_status = wholesale_status | strip

  assign business_address = blank
  if customer.default_address != blank
    assign addr = customer.default_address
    if addr.address1 != blank
      assign business_address = addr.address1
    endif
    if addr.city != blank
      if business_address != blank
        assign business_address = business_address | append: ', '
      endif
      assign business_address = business_address | append: addr.city
    endif
    if addr.province != blank
      if business_address != blank
        assign business_address = business_address | append: ', '
      endif
      assign business_address = business_address | append: addr.province
    endif
    if addr.zip != blank
      if business_address != blank
        assign business_address = business_address | append: ' '
      endif
      assign business_address = business_address | append: addr.zip
    endif
  endif

  assign certificate_url = blank
  assign certificate_name = blank
  assign certificate_file = blank

  assign certificate_file = customer.metafields.customer_fields.upload_resale_certificate.value
  if certificate_file == blank
    assign certificate_file = customer.metafields.custom.upload_resale_certificate.value
  endif
  if certificate_file == blank
    assign certificate_file = customer.metafields.customer_fields.upload_resale_certificate_to_save_on_paying_tax.value
  endif
  if certificate_file == blank
    assign certificate_file = customer.metafields.custom.upload_resale_certificate_to_save_on_paying_tax.value
  endif
  if certificate_file == blank
    assign certificate_file = customer.metafields.customer_fields.upload_resale_certificate_.value
  endif
  if certificate_file == blank
    assign certificate_file = customer.metafields.custom.upload_resale_certificate_.value
  endif

  assign cf_data = customer.metafields.customer_fields.data.value
  if certificate_file == blank and cf_data != blank
    assign certificate_file = cf_data.upload_resale_certificate
    if certificate_file == blank
      assign certificate_file = cf_data.upload_resale_certificate_to_save_on_paying_tax
    endif
    if certificate_file == blank
      assign certificate_file = cf_data.upload_resale_certificate_
    endif
  endif

  if certificate_file != blank
    if certificate_file.url != blank
      assign certificate_url = certificate_file.url
      assign certificate_name = certificate_file.name
    elsif certificate_file contains 'http'
      assign certificate_url = certificate_file
    endif
  endif

  if certificate_url == blank
    for metafield in customer.metafields.customer_fields
      if certificate_url == blank
        assign key_lower = metafield.key | downcase
        if key_lower contains 'resale' or key_lower contains 'certificate' or key_lower contains 'upload_resale'
          if metafield.value.url != blank
            assign certificate_url = metafield.value.url
            assign certificate_name = metafield.value.name
          elsif metafield.value != blank and metafield.value contains 'http'
            assign certificate_url = metafield.value
          endif
        endif
      endif
    endfor
  endif

  if certificate_url == blank
    for metafield in customer.metafields.custom
      if certificate_url == blank
        assign key_lower = metafield.key | downcase
        if key_lower contains 'resale' or key_lower contains 'certificate' or key_lower contains 'upload_resale'
          if metafield.value.url != blank
            assign certificate_url = metafield.value.url
            assign certificate_name = metafield.value.name
          elsif metafield.value != blank and metafield.value contains 'http'
            assign certificate_url = metafield.value
          endif
        endif
      endif
    endfor
  endif

  assign customer_since = blank

  if section.settings.customer_since_metafield_key != blank
    assign since_key = section.settings.customer_since_metafield_key
    for metafield in customer.metafields.customer_fields
      if customer_since == blank and metafield.key == since_key and metafield.value != blank
        assign customer_since = metafield.value | date: '%B %d, %Y'
      endif
    endfor
    for metafield in customer.metafields.custom
      if customer_since == blank and metafield.key == since_key and metafield.value != blank
        assign customer_since = metafield.value | date: '%B %d, %Y'
      endif
    endfor
  endif

  if customer_since == blank
    for metafield in customer.metafields.customer_fields
      if customer_since == blank and metafield.value != blank
        assign since_key_lower = metafield.key | downcase
        if metafield.type == 'date' or metafield.type == 'date_time'
          if since_key_lower contains 'since' or since_key_lower contains 'registration' or since_key_lower contains 'created' or since_key_lower contains 'submitted'
            assign customer_since = metafield.value | date: '%B %d, %Y'
          endif
        endif
      endif
    endfor
  endif

  if customer_since == blank and customer.orders.size > 0
    assign first_order = customer.orders | sort: 'created_at' | first
    if first_order != blank
      assign customer_since = first_order.created_at | date: '%B %d, %Y'
    endif
  endif

  assign needs_since_fallback = true
  if customer_since != blank
    assign needs_since_fallback = false
  endif

  assign lifetime_savings = 0
  if customer.orders.size > 0
    for order in customer.orders
      for line_item in order.line_items
        assign retail_unit = line_item.original_price
        assign cap = line_item.variant.compare_at_price
        if cap != blank and cap > retail_unit
          assign retail_unit = cap
        endif
        assign wholesale_unit = line_item.final_price
        assign unit_diff = retail_unit | minus: wholesale_unit
        if unit_diff > 0
          assign line_savings = unit_diff | times: line_item.quantity
          assign lifetime_savings = lifetime_savings | plus: line_savings
        endif
      endfor
    endfor
  endif

  assign dashboard_url = request.path
-%}

<section
  class="wholesale-dashboard section"
  data-section-id="{{ section.id }}"
  data-section-type="wholesale-dashboard"
  data-wholesale-dashboard
  {% if needs_since_fallback %}data-load-customer-since="true"{% endif %}
  data-customer-id="{{ customer.id }}"
>
  <div class="wholesale-dashboard__inner">
    {%- unless is_wholesale -%}
      <div class="wholesale-dashboard__denied">
        <h2 class="wholesale-dashboard__denied-title">Wholesale Dashboard</h2>
        <p class="wholesale-dashboard__denied-text">
          You need an approved wholesale account to access this page.
        </p>
        <a href="/pages/wholesale" class="wholesale-dashboard__btn" style="width: auto; display: inline-flex;">
          Login
        </a>
      </div>
    {%- else -%}
      <button
        type="button"
        class="wholesale-dashboard__mobile-toggle"
        data-sidebar-toggle
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        Menu
      </button>

      <div class="wholesale-dashboard__overlay" data-sidebar-overlay></div>

      <div class="wholesale-dashboard__layout">
        {%- comment -%} Sidebar {%- endcomment -%}
        <aside class="wholesale-dashboard__sidebar" data-sidebar>
          <span class="btn-cross">
<svg xmlns="http://www.w3.org/2000/svg" fill="none" class="icon icon-close" viewBox="0 0 18 17"><path fill="currentColor" d="M.865 15.978a.5.5 0 0 0 .707.707l7.433-7.431 7.579 7.282a.501.501 0 0 0 .846-.37.5.5 0 0 0-.153-.351L9.712 8.546l7.417-7.416a.5.5 0 1 0-.707-.708L8.991 7.853 1.413.573a.5.5 0 1 0-.693.72l7.563 7.268z"></path></svg>
</span>
          <div class="wholesale-dashboard__profile">
            <div class="wholesale-dashboard__avatar" aria-hidden="true">
              {{- customer_initials -}}
            </div>
            <p class="wholesale-dashboard__name">{{ customer.name }}</p>
            <p class="wholesale-dashboard__email">{{ customer.email }}</p>

            <div class="wholesale-dashboard__status-card">
              <p class="wholesale-dashboard__status-label">Wholesale Account</p>
              <p class="wholesale-dashboard__status-approved">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                  <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
                Status: Approved
              </p>
            </div>
          </div>

          <nav aria-label="Wholesale dashboard navigation">
            <ul class="wholesale-dashboard__nav">
              <li class="wholesale-dashboard__nav-item">
                <a href="{{ dashboard_url }}" class="wholesale-dashboard__nav-link is-active" aria-current="page" data-dashboard-nav="dashboard">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                  Dashboard
                </a>
              </li>
              <li class="wholesale-dashboard__nav-item">
                <a href="#company-profile" class="wholesale-dashboard__nav-link" data-dashboard-nav="company-profile">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                  Company Profile
                </a>
              </li> 
              <li class="wholesale-dashboard__nav-item">
                <a href="{{ routes.account_addresses_url }}" class="wholesale-dashboard__nav-link">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                  Addresses
                </a>
              </li>
              <li class="wholesale-dashboard__nav-item">
                <a href="#tax-exemption" class="wholesale-dashboard__nav-link" data-dashboard-nav="tax-exemption">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                  Tax Exemption
                </a>
              </li>
               <li class="wholesale-dashboard__nav-item">
                <a href="{{ routes.account_url }}" class="wholesale-dashboard__nav-link">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                  Order History
                </a>
              </li>
              {% comment %} <li class="wholesale-dashboard__nav-item">
                <a href="/pages/contact" class="wholesale-dashboard__nav-link">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                  Quotes
                </a>
              </li> {% endcomment %}
              <li class="wholesale-dashboard__nav-item">
                <a href="/pages/quick-order" class="wholesale-dashboard__nav-link">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                  Quick Reorder
                </a>
              </li>
              {% comment %} <li class="wholesale-dashboard__nav-item">
                <a href="{{ dashboard_url }}#account-manager" class="wholesale-dashboard__nav-link">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                  Account Manager
                </a>
              </li> {% endcomment %}
              {% comment %} <li class="wholesale-dashboard__nav-item">
                <a href="{{ dashboard_url }}#notifications" class="wholesale-dashboard__nav-link">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                  Notifications
                </a>
              </li> {% endcomment %}
              <li class="wholesale-dashboard__nav-item">
                <a href="{{ routes.account_logout_url }}" class="wholesale-dashboard__nav-link wholesale-dashboard__nav-link--logout">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                  Logout
                </a>
              </li>
            </ul>
          </nav>
        </aside>

        {%- comment -%} Main content {%- endcomment -%}
        <div class="wholesale-dashboard__main">
          <header class="wholesale-dashboard__welcome">
            <h1 class="wholesale-dashboard__welcome-title">
              Welcome back, {{ customer.first_name }}!
            </h1>
            {% comment %} <p class="wholesale-dashboard__welcome-subtitle">
              Here's an overview of your wholesale account.
            </p> {% endcomment %}
          </header>

          {%- comment -%} Summary cards {%- endcomment -%}
          <div class="wholesale-dashboard__summary">
            {% comment %} <div class="wholesale-dashboard__card">
              <div class="wholesale-dashboard__card-header">
                <div class="wholesale-dashboard__card-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                </div>
                <div>
                  <p class="wholesale-dashboard__card-label">Account Status</p>
                  <p class="wholesale-dashboard__card-value wholesale-dashboard__card-value--verified">Approved</p>
                  {% comment %} <p class="wholesale-dashboard__card-sub">Wholesale Account</p> {% endcomment %}
                </div>
              </div>
            </div> {% endcomment %}

            <div class="wholesale-dashboard__card" id="b2b-savings">
              <div class="wholesale-dashboard__card-header">
                <div class="wholesale-dashboard__card-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                </div>
                <div>
                  <p class="wholesale-dashboard__card-label">Lifetime B2B Savings</p>
                  {%- if customer.orders.size > 0 and lifetime_savings > 0 -%}
                    <p class="wholesale-dashboard__card-value wholesale-dashboard__card-value--verified">{{ lifetime_savings | money }}</p>
                    <p class="wholesale-dashboard__card-sub">Saved through wholesale pricing</p>
                  {%- else -%}
                    <p class="wholesale-dashboard__card-value">{{ 0 | money }}</p>
                    {% comment %} <p class="wholesale-dashboard__card-sub">Place an order to start saving</p> {% endcomment %}
                  {%- endif -%}
                </div>
              </div>
            </div>
            <div class="wholesale-dashboard__card">
              <div class="wholesale-dashboard__card-header">
                <div class="wholesale-dashboard__card-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect><path d="M9 22v-4h6v4"></path><line x1="8" y1="6" x2="8.01" y2="6"></line><line x1="16" y1="6" x2="16.01" y2="6"></line><line x1="8" y1="10" x2="8.01" y2="10"></line><line x1="16" y1="10" x2="16.01" y2="10"></line><line x1="8" y1="14" x2="8.01" y2="14"></line><line x1="16" y1="14" x2="16.01" y2="14"></line></svg>
                </div>
                <div>
                  <p class="wholesale-dashboard__card-label">Company Name</p>
                  <p class="wholesale-dashboard__card-value">
                    {%- if company_name != blank -%}
                      {{ company_name }}
                    {%- else -%}
                      Not provided
                    {%- endif -%}
                  </p>
                  {% comment %} <p class="wholesale-dashboard__card-meta">
                    Customer Since<br>
                    <strong>
                      <span data-customer-since>
                        {%- if customer_since != blank -%}
                          {{ customer_since }}
                        {%- endif -%}
                      </span>
                    </strong>
                  </p> {% endcomment %}
                  {% comment %} {%- if business_type != blank -%}
                    <p class="wholesale-dashboard__card-meta">
                      Business Type:<br>
                      <strong>{{ business_type }}</strong>
                    </p>
                  {%- endif -%} {% endcomment %}
                </div>
              </div>
            </div>

          </div>

          {%- comment -%} B2B registration profile {%- endcomment -%}
          <div class="wholesale-dashboard__panel wholesale-dashboard__profile-panel" id="company-profile" data-company-profile-panel hidden style="display: none;">
            <div class="wholesale-dashboard__panel-header">
              <h2 class="wholesale-dashboard__section-title" style="margin-bottom: 0;">Company Profile</h2>
              <a href="{{ routes.account_addresses_url }}" class="wholesale-dashboard__panel-link">Edit Profile</a>
            </div>
            <dl class="wholesale-dashboard__profile-details">
              <div class="wholesale-dashboard__profile-row">
                <dt>Contact Name</dt>
                <dd>{{ customer.name }}</dd>
              </div>
              <div class="wholesale-dashboard__profile-row">
                <dt>Email</dt>
                <dd><a href="mailto:{{ customer.email }}">{{ customer.email }}</a></dd>
              </div>
              {%- if customer_phone != blank -%}
                <div class="wholesale-dashboard__profile-row">
                  <dt>Phone</dt>
                  <dd><a href="tel:{{ customer_phone }}">{{ customer_phone }}</a></dd>
                </div>
              {%- endif -%}
              <div class="wholesale-dashboard__profile-row">
                <dt>Company</dt>
                <dd>
                  {%- if company_name != blank -%}
                    {{ company_name }}
                  {%- else -%}
                    Not provided
                  {%- endif -%}
                </dd>
              </div>
              {%- if business_type != blank -%}
                <div class="wholesale-dashboard__profile-row">
                  <dt>Business Type</dt>
                  <dd>{{ business_type }}</dd>
                </div>
              {%- endif -%}
              {%- if wholesale_status != blank -%}
                <div class="wholesale-dashboard__profile-row">
                  <dt>Wholesale Account</dt>
                  <dd>{{ wholesale_status }}</dd>
                </div>
              {%- endif -%}
              {% comment %} <div class="wholesale-dashboard__profile-row">
                <dt>Customer Since</dt>
                <dd>
                  <span data-customer-since>
                    {%- if customer_since != blank -%}
                      {{ customer_since }}
                    {%- endif -%}
                  </span>
                </dd>
              </div> {% endcomment %}
              {%- if business_address != blank -%}
                <div class="wholesale-dashboard__profile-row">
                  <dt>Business Address</dt>
                  <dd>{{ business_address }}</dd>
                </div>
              {%- endif -%}
              <div class="wholesale-dashboard__profile-row">
                <dt>Resale Certificate</dt>
                <dd>
                  {%- if certificate_url != blank -%}
                    <a href="{{ certificate_url }}" target="_blank" rel="noopener" data-certificate-download>
                      {%- if certificate_name != blank -%}
                        {{ certificate_name }}
                      {%- else -%}
                        View certificate
                      {%- endif -%}
                    </a>
                  {%- else -%}
                    Not uploaded
                  {%- endif -%}
                </dd>
              </div>
            </dl>
          </div>

          {%- comment -%} Tax exemption {%- endcomment -%}
          <div class="wholesale-dashboard__panel wholesale-dashboard__tax-panel" id="tax-exemption" data-tax-exemption-panel hidden style="display: none;">
            <div class="wholesale-dashboard__panel-header">
              <h2 class="wholesale-dashboard__section-title" style="margin-bottom: 0;">Tax Exemption</h2>
            </div>

            <div class="wholesale-dashboard__tax-status">
              {%- if certificate_url != blank -%}
                <div class="wholesale-dashboard__tax-status-badge wholesale-dashboard__tax-status-badge--verified">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                  </svg>
                  Verified
                </div>
                <p class="wholesale-dashboard__tax-status-text">Your resale certificate is on file. Tax-exempt pricing applies to eligible purchases.</p>
              {%- else -%}
                <div class="wholesale-dashboard__tax-status-badge wholesale-dashboard__tax-status-badge--pending">
