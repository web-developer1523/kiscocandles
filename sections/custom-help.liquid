<section class="help-contact-section">
  <div class="page-width">
    <div class="help-contact-wrapper">

      <div class="help-contact-left">
        {% if section.settings.icon != blank %}
          <img
            src="{{ section.settings.icon | image_url: width: 80 }}"
            alt="{{ section.settings.heading }}"
            width="40"
            height="40"
            loading="lazy"
          >
        {% endif %}

        <div class="help-contact-content">
          <h3>{{ section.settings.heading }}</h3>

          {% if section.settings.subheading != blank %}
            <p>{{ section.settings.subheading }}</p>
          {% endif %}
        </div>
      </div>

      <div class="help-contact-links">
        {% for block in section.blocks %}
          <a href="{{ block.settings.link }}">
            {{ block.settings.text }}
          </a>

          {% unless forloop.last %}
            <span class="separator">•</span>
          {% endunless %}
        {% endfor %}
      </div>

    </div>
  </div>
</section>



{% schema %}
{
  "name": "Help Contact",
  "settings": [
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Icon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Need help? Contact our wholesale experts"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub Heading",
      "default": "We're here to assist you."
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Link Text",
          "default": "Email Us"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Help Contact",
      "blocks": [
        {
          "type": "link"
        },
        {
          "type": "link"
        },
        {
          "type": "link"
        }
      ]
    }
  ]
}
{% endschema %}