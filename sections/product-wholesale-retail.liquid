{%- assign is_wholesale = false -%}
{%- if customer and customer.tags contains 'wholesale' -%}
  {%- assign is_wholesale = true -%}
{%- endif -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
-%}

<div
  class="pwrr{% if is_wholesale %} pwrr--wholesale{% else %} pwrr--retail{% endif %}"
  id="pwrr-{{ section.id }}"
  data-section-type="product"
  data-section-id="{{ section.id }}"
  data-pwrr-layout="{% if is_wholesale %}wholesale{% else %}retail{% endif %}"
>
  <div class="pwrr__inner">
    <div class="pwrr__grid">
      {%- comment -%} ── Product image gallery ── {%- endcomment -%}
      <div class="pwrr__gallery{% if section.settings.enable_image_zoom %} lightbox-media-container{% endif %}">
        <div class="pwrr__gallery-main" data-pwrr-main>
          {%- if featured_media -%}
            {%- if section.settings.enable_image_zoom and featured_media.media_type == 'image' -%}
              <a
                href="{{ featured_media.src | image_url }}"
                class="pwrr__gallery-link lightbox-image no-transition"
                data-pswp-src="{{ featured_media.src | image_url }}"
                data-pswp-width="{{ featured_media.width }}"
                data-pswp-height="{{ featured_media.height }}"
                data-cropped="true"
              >
                {{
                  featured_media
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'eager',
                    widths: '400, 600, 800, 1000, 1200',
                    sizes: '(min-width: 960px) 50vw, 100vw',
                    class: 'pwrr__gallery-image',
                    alt: featured_media.alt
                  | default: product.title
                }}
              </a>
            {%- else -%}
              {{
                featured_media
                | image_url: width: 1200
                | image_tag:
                  loading: 'eager',
                  widths: '400, 600, 800, 1000, 1200',
                  sizes: '(min-width: 960px) 50vw, 100vw',
                  class: 'pwrr__gallery-image',
                  alt: featured_media.alt
                | default: product.title
              }}
            {%- endif -%}
          {%- else -%}
            <div class="pwrr__gallery-placeholder">
              {{ 'product-1' | placeholder_svg_tag: 'pwrr__placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="pwrr__gallery-thumbs" role="list">
            {%- for media in product.media -%}
              <button
                type="button"
                class="pwrr__gallery-thumb{% if media.id == featured_media.id %} is-active{% endif %}"
                data-pwrr-thumb
                data-media-id="{{ media.id }}"
                data-media-src="{{ media | image_url: width: 1200 }}"
                data-media-width="{{ media.width }}"
                data-media-height="{{ media.height }}"
                data-media-alt="{{ media.alt | default: product.title | escape }}"
                aria-label="{{ media.alt | default: product.title | escape }}"
                role="listitem"
              >
                {{
                  media
                  | image_url: width: 120
                  | image_tag:
                    loading: 'lazy',
                    widths: '60, 80, 100, 120',
                    sizes: '60px',
                    class: 'pwrr__gallery-thumb-image',
                    alt: ''
                }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ── Product details ── {%- endcomment -%}
      <div class="pwrr__details">
        {% if is_wholesale %}
          {%- comment -%} WHOLESALE LAYOUT — pricing & ATC via SparkLayer {%- endcomment -%}
          <h1 class="pwrr__title">{{ product.title }}</h1>

          {% comment %} <span class="pwrr__badge">Wholesale Account</span> {% endcomment %}

          <div class="pwrr__spark-pdp">
            <spark-pdp parent-id="{{ product.id }}"></spark-pdp>
          </div>

          <ul class="pwrr__perks">
            {%- if section.settings.perk_1 != blank -%}
              <li class="pwrr__perk">{{ section.settings.perk_1 }}</li>
            {%- endif -%}
            {%- if section.settings.perk_2 != blank -%}
              <li class="pwrr__perk">{{ section.settings.perk_2 }}</li>
            {%- endif -%}
            {%- if section.settings.perk_3 != blank -%}
              <li class="pwrr__perk">{{ section.settings.perk_3 }}</li>
            {%- endif -%}
          </ul>

          {%- if section.settings.help_heading != blank -%}
            {% render 'custom-help-tabs', section: section %}
          {%- endif -%}

{% comment %}
          {%- if product.description != blank -%}
            <div class="pwrr__description rte">
              {{ product.description }}
            </div>
          {%- endif -%} {% endcomment %}

        {% else %}
          {%- comment -%} RETAIL LAYOUT {%- endcomment -%}
          <h1 class="pwrr__title">{{ product.title }}</h1>

          <div data-spark="b2c-only">
            <div class="pwrr__price-block">
              <div class="pwrr__price-row">
                {%- if product.compare_at_price > product.price -%}
                  <s class="pwrr__compare-price">{{ product.compare_at_price | money }}</s>
                {%- endif -%}
                <span class="pwrr__price">{{ product.price | money }}</span>
              </div>
            </div>

            {% form 'product',
              product,
              class: 'pwrr__form product-form',
              data-product-form: '',
              data-product-handle: product.handle,
              data-current-product-id: current_variant.id
            %}
              {%- unless product.has_only_default_variant -%}
                <div class="pwrr__field">
                  <label class="pwrr__label" for="pwrr-variant-{{ section.id }}">
                    {{ 'products.product.choose_options' | t }}
                  </label>
                  <div class="pwrr__select-wrap">
                    <select
                      name="id"
                      id="pwrr-variant-{{ section.id }}"
                      class="input pwrr__select"
                      data-variant-select
                    >
                      {%- for variant in product.variants -%}
                        <option
                          value="{{ variant.id }}"
                          {% if variant == current_variant %}
                            selected
                          {% endif %}
                          {% unless variant.available %}
                            disabled
                          {% endunless %}
                        >
                          {{ variant.title -}}
                          {%- unless variant.available %} — {{ 'products.product.sold_out' | t }}{% endunless %}
                        </option>
                      {%- endfor -%}
                    </select>
                  </div>
                </div>
              {%- else -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}">
              {%- endunless -%}

              <div class="pwrr__field">
                <label class="pwrr__label" for="pwrr-qty-{{ section.id }}">
                  {{ 'products.product.quantity' | t }}
                </label>
                <input
                  type="number"
                  id="pwrr-qty-{{ section.id }}"
                  name="quantity"
                  class="input pwrr__qty"
                  value="1"
                  min="1"
                  pattern="[0-9]*"
                >
              </div>

              <button
                type="submit"
                name="add"
                class="btn btn--medium btn--full btn--primary pwrr__atc"
                data-add-to-cart
                {% unless current_variant.available %}
                  disabled aria-disabled="true"
                {% endunless %}
              >
                <span data-add-to-cart-text>
                  {%- if current_variant.available -%}
                    {{ 'products.product.add_to_cart' | t }}
                  {%- else -%}
                    {{ 'products.product.sold_out' | t }}
                  {%- endif -%}
                </span>
              </button>
            {% endform %}
          </div>

          {% comment %} {%- if product.description != blank -%}
            <div class="pwrr__description rte">
              {{ product.description }}
            </div>
          {%- endif -%} {% endcomment %}

          {%- unless customer -%}
            <div class="pwrr__info-box">
              <p>
                {{ 'Already have an account?' }}
                <a href="{{ routes.account_login_url }}" class="pwrr__link">
                  {{ 'Log in for member pricing' }}
                </a>
              </p>
            </div>
          {%- endunless -%}

          {%- assign wholesale_apply_url = section.settings.wholesale_apply_url | default: '/pages/wholesale-signup' -%}
          {%- if wholesale_apply_url != blank -%}
            <div class="pwrr__cta-box">
              <p class="pwrr__cta-text">Are you a business? Apply for wholesale access</p>
              <a href="{{ wholesale_apply_url }}" class="btn btn--secondary btn--medium pwrr__cta-btn"> Apply now </a>
            </div>
          {%- endif -%}
        {% endif %}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="pwrr__blocks">
        {%- render 'product-blocks',
          prod: product,
          blocks: section.blocks,
          current_variant: current_variant,
          featured_media: featured_media,
          aspect_ratio: 'natural',
          price_content_type: 'price',
          custom_price_content: blank,
          is_quick: false,
          is_featured: false
        -%}
      </div>
    {%- endif -%}
  </div>
  
</div>

<script>
  (function () {
    var root = document.getElementById('pwrr-{{ section.id }}');
    if (!root) return;

    var main = root.querySelector('[data-pwrr-main]');
    var thumbs = root.querySelectorAll('[data-pwrr-thumb]');
    var zoomEnabled = {{ section.settings.enable_image_zoom | json }};

    thumbs.forEach(function (thumb) {
      thumb.addEventListener('click', function () {
        thumbs.forEach(function (t) { t.classList.remove('is-active'); });
        thumb.classList.add('is-active');

        var src = thumb.getAttribute('data-media-src');
        var width = thumb.getAttribute('data-media-width');
        var height = thumb.getAttribute('data-media-height');
        var alt = thumb.getAttribute('data-media-alt') || '';

        if (zoomEnabled) {
          main.innerHTML =
            '<a href="' + src + '" class="pwrr__gallery-link lightbox-image no-transition"' +
            ' data-pswp-src="' + src + '"' +
            ' data-pswp-width="' + width + '"' +
            ' data-pswp-height="' + height + '"' +
            ' data-cropped="true">' +
            '<img src="' + src + '" alt="' + alt.replace(/"/g, '&quot;') + '" class="pwrr__gallery-image" loading="lazy">' +
            '</a>';
        } else {
          main.innerHTML =
            '<img src="' + src + '" alt="' + alt.replace(/"/g, '&quot;') + '" class="pwrr__gallery-image" loading="lazy">';
        }
      });
    });
  })();
</script>

<style>
  .pwrr {
    background-color: var(--color-background);
    color: var(--color-text);
    padding: var(--spacing-section, 48px) 0;
  }

  .pwrr__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-outer, 24px);
  }

  .pwrr__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 960px) {
    .pwrr__grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      align-items: start;
    }
  }

  .pwrr__gallery-main {
    position: relative;
    background-color: var(--color-background-meta);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    overflow: hidden;
    aspect-ratio: 1;
  }

  .pwrr__gallery-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pwrr__gallery-link {
    display: block;
    width: 100%;
    height: 100%;
    color: inherit;
  }

  .pwrr__gallery-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: var(--color-background-placeholder);
  }

  .pwrr__placeholder-svg {
    width: 50%;
    height: auto;
    fill: var(--color-foreground-placeholder);
  }

  .pwrr__gallery-thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .pwrr__gallery-thumb {
    flex: 0 0 auto;
    width: 64px;
    height: 64px;
    padding: 0;
    border: 2px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-background);
    cursor: pointer;
    overflow: hidden;
    transition: border-color 0.15s ease;
  }

  .pwrr__gallery-thumb.is-active,
  .pwrr__gallery-thumb:hover {
    border-color: var(--color-background-button);
  }

  .pwrr__gallery-thumb-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pwrr__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-heading-2-base);
    font-weight: var(--font-heading-weight);
    line-height: var(--line-height-heading);
    margin: 0 0 1rem;
    color: var(--color-text);
  }

  .pwrr__badge {
    display: inline-block;
    margin-bottom: 1rem;
    padding: 0.35em 0.85em;
    font-size: var(--font-size-body-50);
    font-family: var(--font-body);
    font-weight: var(--font-body-bold-weight);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background-color: var(--color-background-button);
    color: var(--color-text-button);
    border-radius: 3px;
  }

  .pwrr__spark-pdp {
    margin: 0 0 1.25rem;
  }

  .pwrr__price-block {
    margin-bottom: 1.25rem;
  }

  .pwrr__price-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pwrr__compare-price {
    font-size: var(--font-size-body-100);
    color: var(--color-text-meta);
    text-decoration: line-through;
  }

  .pwrr__price {
    font-size: var(--font-size-heading-4-base);
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    color: var(--color-text);
  }

  .pwrr__form {
    margin-bottom: 1.25rem;
  }

  .pwrr__field {
    margin-bottom: 1rem;
  }

  .pwrr__label {
    display: block;
    margin-bottom: 0.35rem;
    font-size: var(--font-size-body-75);
    font-weight: var(--font-body-bold-weight);
    color: var(--color-text);
  }

  .pwrr__select-wrap {
    position: relative;
  }

  .pwrr__select,
  .pwrr__qty {
    width: 100%;
    max-width: 280px;
    background-color: var(--color-background);
    color: var(--color-text-input);
    border: 1px solid var(--color-border-input);
  }

  .pwrr__atc {
    margin-top: 0.5rem;
  }

  .pwrr__perks {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
  }

  .pwrr__perk {
    position: relative;
    padding: 0.4rem 0 0.4rem 1.5rem;
    font-size: var(--font-size-body-75);
    color: var(--color-text);
  }

  .pwrr__perk::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--color-background-button);
  }

  .pwrr__description {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    font-size: var(--font-size-body-100);
    color: var(--color-text);
    line-height: var(--line-height-body);
  }

  .pwrr__info-box {
    margin-top: 1.5rem;
    padding: 1rem 1.25rem;
    background-color: var(--color-background-meta);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    font-size: var(--font-size-body-75);
    color: var(--color-text-meta);
  }

  .pwrr__info-box p {
    margin: 0;
  }

  .pwrr__link {
    color: var(--color-text-link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .pwrr__link:hover {
    color: var(--color-text);
  }

  .pwrr__cta-box {
    margin-top: 1rem;
    padding: 1.25rem;
    background-color: var(--color-background-outline-button-alpha, var(--color-background-meta));
    border: 1px solid var(--color-border);
    border-radius: 4px;
    text-align: center;
  }

  .pwrr__cta-text {
    margin: 0 0 0.75rem;
    font-size: var(--font-size-body-100);
    font-weight: var(--font-body-bold-weight);
    color: var(--color-text);
  }

  .pwrr__cta-btn {
    display: inline-block;
  }

  .pwrr__blocks {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
</style>

{% schema %}
{
  "name": "Wholesale Retail Product",
  "tag": "section",
  "class": "pwrr-section",
  "limit": 1,
  "templates": ["product"],
  "settings": [
    {
      "type": "paragraph",
      "content": "Wholesale pricing, volume breaks, MOQ, and add-to-cart are managed by SparkLayer B2B. Configure price lists in the SparkLayer app."
    },
    {
      "type": "header",
      "content": "Gallery"
    },
    {
      "type": "checkbox",
      "id": "enable_image_zoom",
      "label": "Enable image zoom",
      "default": true
    },
    {
      "type": "header",
      "content": "Wholesale perks"
    },
    {
      "type": "text",
      "id": "perk_1",
      "label": "Perk 1",
      "default": "Exclusive bulk pricing"
    },
    {
      "type": "text",
      "id": "perk_2",
      "label": "Perk 2",
      "default": "Free shipping on qualifying orders"
    },
    {
      "type": "text",
      "id": "perk_3",
      "label": "Perk 3",
      "default": "Dedicated account support"
    },
    {
      "type": "header",
      "content": "Retail"
    },
    {
      "type": "url",
      "id": "wholesale_apply_url",
      "label": "Wholesale application URL",
      "info": "Shown on the retail layout. Defaults to /pages/wholesale-signup if left blank."
    },
    {
      "type": "header",
      "content": "Help Contact"
    },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Icon"
    },
    {
      "type": "text",
      "id": "help_heading",
      "label": "Heading",
      "default": "Need help? Contact our wholesale experts"
    },
    {
      "type": "text",
      "id": "help_subheading",
      "label": "Sub Heading",
      "default": "We're here to assist you."
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "custom_liquid",
      "name": "t:sections.main_product_overview.blocks.custom_liquid.name",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "t:sections.custom_liquid.settings.custom_liquid.label"
        }
      ]
    },
    {
      "type": "accordion",
      "name": "t:sections.main_product_details.blocks.accordion.name",
      "settings": [
        {
          "type": "checkbox",
          "id": "expand_by_default",
          "label": "t:sections.main_product_details.blocks.accordion.settings.expand_by_default.label",
          "default": false
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.main_product_details.blocks.accordion.settings.heading.label",
          "default": "Collapsible row"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:sections.main_product_details.blocks.accordion.settings.content.label",
          "default": "<p>Add your collapsible row content here.</p>"
        },
        {
          "type": "page",
          "id": "page_for_content",
          "label": "t:sections.main_product_details.blocks.accordion.settings.page_for_content.label"
        }
      ]
    },
    {
      "type": "help_link",
      "name": "Help Contact Link",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Link Text",
          "default": "Email Us"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    },
    {
      "type": "product_callouts",
      "name": "t:sections.main_product_overview.blocks.product_callouts.name",
      "settings": [
        {
          "id": "custom_class",
          "type": "text",
          "label": "Custom class"
        },
        {
          "id": "add_box",
          "type": "checkbox",
          "label": "t:sections.main_product_overview.blocks.product_callouts.settings.add_box.label",
          "default": true
        },
        {
          "id": "add_dividers",
          "type": "checkbox",
          "label": "t:sections.main_product_overview.blocks.product_callouts.settings.add_dividers.label",
          "default": true
        },
        {
          "id": "icon_1",
          "type": "text",
          "label": "Icon 1",
          "default": "chat"
        },
        {
          "id": "text_1",
          "type": "richtext",
          "label": "Text 1"
        },
        {
          "id": "icon_2",
          "type": "text",
          "label": "Icon 2",
          "default": "none"
        },
        {
          "id": "text_2",
          "type": "richtext",
          "label": "Text 2"
        },
        {
          "id": "icon_3",
          "type": "text",
          "label": "Icon 3",
          "default": "none"
        },
        {
          "id": "text_3",
          "type": "richtext",
          "label": "Text 3"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wholesale Retail Product"
    }
  ]
}
{% endschema %}
