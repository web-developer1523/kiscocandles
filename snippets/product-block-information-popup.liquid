{% assign textDn = text | downcase | strip%}
<a
  class="product__information-popup product__block product__block--medium fs-body-75"
  {% if textDn == 'candle size guide' %} id="product-candle-size-guide"{% endif %}
  {% unless textDn == 'candle size guide' %}
  data-popup-trigger
  data-modal-content-id="modal-{{ popup_page_target }}-{{ block.id }}"
  {% endunless %}
  href="{% if textDn == 'candle size guide' %}javascript:void(0);{% else %}{{ popup_page.url }}{% endif %}"
>
  {%- if custom_icon_image != blank -%}
    {%-
      render 'image' with
      wrapper_class: "product__information-popup-custom-icon",
      image: custom_icon_image,
      sizes: "32px",
    -%}
  {%- else -%}
    {%- if icon != 'none' -%}{% render 'icon-editorial' with icon: icon %}{%- endif -%}
  {%- endif -%}
  {{ text }}
</a>
<div
  id="modal-{{ popup_page_target }}-{{ block.id }}"
  class="information-popup__content modal-content"
  aria-modal="true"
>
  <h2 class="ff-heading fs-heading-2-base">{{ popup_page.title }}</h2>

  {{ popup_page.content }}
</div>
