<section class="help-contact-section">
  <div class="page-width">
    <div class="help-contact-wrapper">

      <div class="help-contact-left">
        {% if section.settings.icon != blank %}
          <img
            src="{{ section.settings.icon | image_url: width: 80 }}"
            alt="{{ section.settings.help_heading }}"
            width="40"
            height="40"
            loading="lazy"
          >
        {% endif %}

        <div class="help-contact-content">
          <h3>{{ section.settings.help_heading }}</h3>

          {% if section.settings.help_subheading != blank %}
            <p>{{ section.settings.help_subheading }}</p>
          {% endif %}
        </div>
      </div>

      <div class="help-contact-links">
        {% for block in section.blocks %}
          <a href="{{ block.settings.link }}">
            {{ block.settings.text }}
          </a>

          {% unless forloop.last %}
            <span class="separator">•</span>
          {% endunless %}
        {% endfor %}
      </div>

    </div>
  </div>
</section>

<style>
.help-contact-section{
  padding:16px 0;
}

.help-contact-wrapper{
  display:flex;
  justify-content:space-between;
  align-items:center;
  border:1px solid #e5e5e5;
  border-radius:10px;
  padding:16px 24px;
  gap:20px;
}

.help-contact-left{
  display:flex;
  align-items:center;
  gap:15px;
}

.help-contact-left img{
  width:40px;
  height:40px;
  object-fit:contain;
}

.help-contact-content h3{
  margin:0;
  font-size:18px;
  font-weight:600;
  color:#111;
}

.help-contact-content p{
  margin:4px 0 0;
  font-size:14px;
  color:#777;
}

.help-contact-links{
  display:flex;
  align-items:center;
  flex-wrap:wrap;
  gap:12px;
}

.help-contact-links a{
  text-decoration:none;
  color:#222;
  font-size:15px;
}

.help-contact-links a:hover{
  text-decoration:underline;
}

.separator{
  color:#999;
}

@media(max-width:749px){

  .help-contact-wrapper{
    flex-direction:column;
    align-items:flex-start;
  }

  .help-contact-links{
    width:100%;
  }

}
</style>