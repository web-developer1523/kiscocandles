{%- comment -%}
  Account link for new customer accounts.
  Logged out  → new customer accounts login (returns to wholesale dashboard)
  Wholesale   → wholesale dashboard on your store
  Everyone else → Shopify account (orders)
{%- endcomment -%}

{%- liquid
  assign account_label = 'Account'

  unless customer
    capture account_href
      render 'customer-login-url'
    endcapture
    assign account_href = account_href | strip
  endunless

  if customer
    if customer.tags contains 'wholesale'
      assign account_href = '/pages/wholesale-dashboard'
      if customer.first_name != blank
        assign account_label = customer.first_name
      endif
    else
      assign account_href = routes.account_url
      if customer.first_name != blank
        assign account_label = customer.first_name
      endif
    endif
  endif
-%}

<a
  class="header__icon-touch header__icon-touch--account"
  href="{{ account_href }}"
  aria-label="{{ 'general.accessibility.go_account' | t }}"
>
  {% render 'icon-button' with icon: 'header-account' %}
  <span class="text-account">{{ account_label }}</span>
</a>
