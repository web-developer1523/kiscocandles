{%- liquid
  comment
    Renders swatches for the product-item hover display.

    Required parameters:
      - prod: { Object } The product that the swatches are associated with.
      - option_name: { String } The option name whose values should display as swatches. Is downcased and has newlines stripped.

    Optional parameters:
      - show_sibling_swatches: { Boolean } Whether sibling swatches are enabled.
      - sibling_products: { Object } A list of sibling products.
  endcomment

  case settings.product_card_swatch_size
    when 'large'
      assign max_items = 3
      assign width_multiplier = 2
    when 'medium'
      assign max_items = 4
      assign width_multiplier = 1.5
    else
      assign max_items = 5
      assign width_multiplier = 1
  endcase

  case settings.swatch_shape
    when 'rectangle'
      assign swatch_width = 28 | times: width_multiplier
    else
      assign swatch_width = 16 | times: width_multiplier
  endcase

  assign swatch_image_width = swatch_width | times: 2

  capture swatch_style
    echo '--swatch-width: [[sw]]px;' | replace: '[[sw]]', swatch_width
    echo '--swatch-image-fit: [[sif]];' | replace: '[[sif]]', settings.swatch_image_fit
  endcapture
-%}

<div
  class="product-swatches-options"
  style="{{ swatch_style }}"
>
  <ul class="product-swatches-options__list ff-body fs-body-50">
    {% if prod.has_only_default_variant == false and show_sibling_swatches == false %}
      {% comment %} Regular swatches {% endcomment %}
      {% assign option_values_count = prod.options_by_name[option_name].values.size %}
      {%- assign variantImg = prod.image | img_url:'500x' -%}
      {%- assign variantPrice = prod.variants.first.price | money -%}
      {%- assign variantCalPrice = prod.variants.first.price -%}
      {% assign pPack = prod.metafields.my_fields.count | plus: 0 %}
      {%- comment %}<locksmith:b3c0>{% endcomment -%}
        {%- assign locksmith_5990_forloop__size = 0 %}{%- for value in prod.options_by_name[option_name].values -%}{% capture var %}{% render 'locksmith-variables', scope: 'subject', subject: value, subject_parent: prod.options_by_name[option_name], variable: 'transparent' %}{% endcapture %}{% if var == 'true' %}{% assign locksmith_5990_forloop__size = locksmith_5990_forloop__size | plus: 1 %}{% endif %}{% endfor %}{% assign locksmith_5990_forloop__index = nil -%}
      {%- comment %}</locksmith:b3c0>{% endcomment -%}
      {%- for value in prod.options_by_name[option_name].values -%}
        {%- comment %}<locksmith:4c72>{% endcomment -%}
          {%- capture var %}{% render 'locksmith-variables', scope: 'subject', subject: value, subject_parent: prod.options_by_name[option_name], variable: 'transparent' %}{% endcapture %}{% if var == "true" %}{% if locksmith_5990_forloop__index == nil %}{% assign locksmith_5990_forloop__index = 1 %}{% assign locksmith_5990_forloop__index0 = 0 %}{% else %}{% assign locksmith_5990_forloop__index = locksmith_5990_forloop__index | plus: 1 %}{% assign locksmith_5990_forloop__index0 = locksmith_5990_forloop__index0 | plus: 1 %}{% endif %}{% if locksmith_5990_forloop__index == 1 %}{% assign locksmith_5990_forloop__first = true %}{% else %}{% assign locksmith_5990_forloop__first = false %}{% endif %}{% if locksmith_5990_forloop__index == locksmith_5990_forloop__size %}{% assign locksmith_5990_forloop__last = true %}{% else %}{% assign locksmith_5990_forloop__last = false %}{% endif %}{% assign locksmith_5990_forloop__rindex = locksmith_5990_forloop__size | minus: locksmith_5990_forloop__index | minus: 1 %}{% assign locksmith_5990_forloop__rindex0 = locksmith_5990_forloop__size | minus: locksmith_5990_forloop__index0 | minus: 1 %}{% else %}{% continue %}{% endif -%}
        {%- comment %}</locksmith:4c72>{% endcomment -%}
        {%- assign optionIndex = prod.options_by_name[option_name].position | minus:1 -%}
        {%- for variant in prod.variants -%}
          {%- comment %}<locksmith:1c67>{% endcomment -%}
            {%- capture var %}{% render 'locksmith-variables', scope: 'subject', subject: variant, subject_parent: prod, variable: 'transparent' %}{% endcapture %}{% if var == "true" %}{% else %}{% continue %}{% endif -%}
          {%- comment %}</locksmith:1c67>{% endcomment -%}
          {% assign varValue = variant.options[optionIndex] %}
          {%- if varValue == value -%}
            {%- assign variantImg = variant.image | img_url:'500x' -%}
            {%- assign variantPrice = variant.price | money -%}
            {%- assign variantCalPrice = variant.price -%}
            {%- if variant.metafields.custom.count -%}
              {%- assign pPack = variant.metafields.custom.count | plus: 0 -%}
            {%- endif -%}
            {% break %}
          {%- endif -%}
        {%- endfor -%}
        {%- assign perPackPrice = variantCalPrice | divided_by: pPack | round | money | append:' ea.' -%}
        {% render 'product-swatch',
          context: 'product-item',
          index: locksmith_5990_forloop__index,
          prod: prod,
          swatch_image_width: swatch_image_width,
          option_index: prod.options_by_name[option_name].position,
          option_name: option_name,
          option_value: value,
          max_items:max_items,
          variantImg:variantImg,
          variantPrice:variantPrice,
          perPackPrice:perPackPrice
        %}
      {%- endfor -%}
    {% else %}
      {% comment %} Sibling swatches {% endcomment %}
      {% assign option_values_count = sibling_products.size %}

      {%- comment %}<locksmith:e910>{% endcomment -%}
        {%- assign locksmith_832b_forloop__size = 0 %}{%- for sibling_product in sibling_products -%}{% capture var %}{% render 'locksmith-variables', scope: 'subject', subject: sibling_product, variable: 'transparent' %}{% endcapture %}{% if var == 'true' %}{% assign locksmith_832b_forloop__size = locksmith_832b_forloop__size | plus: 1 %}{% endif %}{% endfor %}{% assign locksmith_832b_forloop__index = nil -%}
      {%- comment %}</locksmith:e910>{% endcomment -%}
      {%- for sibling_product in sibling_products -%}
        {%- comment %}<locksmith:5512>{% endcomment -%}
          {%- capture var %}{% render 'locksmith-variables', scope: 'subject', subject: sibling_product, variable: 'transparent' %}{% endcapture %}{% if var == "true" %}{% if locksmith_832b_forloop__index == nil %}{% assign locksmith_832b_forloop__index = 1 %}{% assign locksmith_832b_forloop__index0 = 0 %}{% else %}{% assign locksmith_832b_forloop__index = locksmith_832b_forloop__index | plus: 1 %}{% assign locksmith_832b_forloop__index0 = locksmith_832b_forloop__index0 | plus: 1 %}{% endif %}{% if locksmith_832b_forloop__index == 1 %}{% assign locksmith_832b_forloop__first = true %}{% else %}{% assign locksmith_832b_forloop__first = false %}{% endif %}{% if locksmith_832b_forloop__index == locksmith_832b_forloop__size %}{% assign locksmith_832b_forloop__last = true %}{% else %}{% assign locksmith_832b_forloop__last = false %}{% endif %}{% assign locksmith_832b_forloop__rindex = locksmith_832b_forloop__size | minus: locksmith_832b_forloop__index | minus: 1 %}{% assign locksmith_832b_forloop__rindex0 = locksmith_832b_forloop__size | minus: locksmith_832b_forloop__index0 | minus: 1 %}{% else %}{% continue %}{% endif -%}
        {%- comment %}</locksmith:5512>{% endcomment -%}
        {% render 'product-swatch',
          context: 'product-item',
          index: locksmith_832b_forloop__index,
          swatch_image_width: swatch_image_width,
          sibling_product: sibling_product,
          option_name: settings.siblings_option_name,
          option_value: sibling_product.metafields.stiletto.sibling_option_name,
          max_items:max_items
        %}
      {%- endfor -%}
    {% endif %}

    {% render 'product-item-swatches-overflow', prod: prod, option_values_count: option_values_count, max_items: max_items %}
  </ul>
</div>
