{%- comment %}<locksmith:705b>{% endcomment -%}
  {%- assign locksmith_67c7_product__has_only_default_variant = false %}{% assign _variants_count = 0 %}{% assign locksmith_67c7_product__first_available_variant = nil %}{% assign locksmith_67c7_product__selected_variant = nil %}{% assign locksmith_67c7_product__selected_or_first_available_variant = nil %}{% for variant in product.variants %}{% capture var %}{% render 'locksmith-variables', scope: 'subject', subject: variant, subject_parent: product, variable: 'transparent' %}{% endcapture %}{% if var == "true" %}{% else %}{% continue %}{% endif %}{% assign _variants_count = _variants_count | plus: 1 %}{% if locksmith_67c7_product__first_available_variant == nil and variant.available %}{% assign locksmith_67c7_product__first_available_variant = variant %}{% endif %}{% if locksmith_67c7_product__selected_variant == nil and variant.selected %}{% assign locksmith_67c7_product__selected_variant = variant %}{% endif %}{% if variant == product.selected_or_first_available_variant %}{% assign locksmith_67c7_product__selected_or_first_available_variant = product.selected_or_first_available_variant %}{% endif %}{% endfor %}{% if _variants_count == 1 %}{% assign locksmith_67c7_product__has_only_default_variant = true %}{% endif %}{% if locksmith_67c7_product__selected_or_first_available_variant == nil %}{% assign locksmith_67c7_product__selected_or_first_available_variant = locksmith_67c7_product__first_available_variant %}{% endif %}{% assign _67c7_safe_variants = '' %}{% for _variant in product.variants %}{% capture var %}{% render 'locksmith-variables', scope: 'subject', subject: _variant, subject_parent: product, variable: 'transparent' %}{% endcapture %}{% if var == "true" %}{% else %}{% continue %}{% endif %}{% capture _67c7_safe_variants %}{% if _67c7_safe_variants != blank %}{{ _67c7_safe_variants }},{% endif %}{{ _variant | json }}{% endcapture %}{% endfor %}{% capture _67c7_safe_variants %}[{{ _67c7_safe_variants }}]{% endcapture %}{% assign _67c7_unsafe_variants = product.variants | json -%}
{%- comment %}</locksmith:705b>{% endcomment -%}

{%- liquid
  assign swatch_options = settings.swatch_options | downcase | split: ', '
  assign chip_options = settings.chip_options | downcase | split: ', '

  # Sibling products
  # Merchants often make the mistake of inputting sibling_collection instead of the
  # documented siblings_collection. We now support both to help with support debt.
  assign sibling_products = product.metafields.stiletto.sibling_collection.value.products | default: product.metafields.stiletto.siblings_collection.value.products

  case settings.swatch_shape
    when 'rectangle'
      case block_settings.swatch_size
        when 'large'
          assign swatch_width = 72
        when 'medium'
          assign swatch_width = 60
        else
          assign swatch_width = 44
      endcase
    else
      case block_settings.swatch_size
        when 'large'
          assign swatch_width = 48
        when 'medium'
          assign swatch_width = 38
        else
          assign swatch_width = 30
      endcase
  endcase

  assign swatch_image_width = swatch_width | times: 2

  capture swatch_style
    echo '--swatch-width: [[sw]]px;' | replace: '[[sw]]', swatch_width
    echo '--swatch-image-fit: [[sif]];' | replace: '[[sif]]', settings.swatch_image_fit
  endcapture
-%}

{% comment %} Siblings {% endcomment %}
{%- if show_siblings
  and product.metafields.stiletto.sibling_option_name
  and sibling_products
  and settings.siblings_option_name != blank
-%}
  <div class="product__block product__block--medium" data-sibling-products>
    <div class="product__label-wrapper">
      <label class="product__label fs-body-100">
        {{ settings.siblings_option_name }}:
        <span class="t-opacity-70" data-sibling-label-value>
          {{- product.metafields.stiletto.sibling_option_name -}}
        </span>
      </label>
    </div>
    <div class="product__color-swatches" style="{{ swatch_style }}">
      <div class="product__color-swatches--inner">
        {%- comment %}<locksmith:4079>{% endcomment -%}
          {%- assign locksmith_c88e_forloop__size = 0 %}{%- for sibling_product in sibling_products -%}{% capture var %}{% render 'locksmith-variables', scope: 'subject', subject: sibling_product, variable: 'transparent' %}{% endcapture %}{% if var == 'true' %}{% assign locksmith_c88e_forloop__size = locksmith_c88e_forloop__size | plus: 1 %}{% endif %}{% endfor %}{% assign locksmith_c88e_forloop__index = nil -%}
        {%- comment %}</locksmith:4079>{% endcomment -%}
        {%- for sibling_product in sibling_products -%}
          {%- comment %}<locksmith:c8ce>{% endcomment -%}
            {%- capture var %}{% render 'locksmith-variables', scope: 'subject', subject: sibling_product, variable: 'transparent' %}{% endcapture %}{% if var == "true" %}{% if locksmith_c88e_forloop__index == nil %}{% assign locksmith_c88e_forloop__index = 1 %}{% assign locksmith_c88e_forloop__index0 = 0 %}{% else %}{% assign locksmith_c88e_forloop__index = locksmith_c88e_forloop__index | plus: 1 %}{% assign locksmith_c88e_forloop__index0 = locksmith_c88e_forloop__index0 | plus: 1 %}{% endif %}{% if locksmith_c88e_forloop__index == 1 %}{% assign locksmith_c88e_forloop__first = true %}{% else %}{% assign locksmith_c88e_forloop__first = false %}{% endif %}{% if locksmith_c88e_forloop__index == locksmith_c88e_forloop__size %}{% assign locksmith_c88e_forloop__last = true %}{% else %}{% assign locksmith_c88e_forloop__last = false %}{% endif %}{% assign locksmith_c88e_forloop__rindex = locksmith_c88e_forloop__size | minus: locksmith_c88e_forloop__index | minus: 1 %}{% assign locksmith_c88e_forloop__rindex0 = locksmith_c88e_forloop__size | minus: locksmith_c88e_forloop__index0 | minus: 1 %}{% else %}{% continue %}{% endif -%}
          {%- comment %}</locksmith:c8ce>{% endcomment -%}
          {% render 'product-swatch',
            context: 'product-page',
            prod: product,
            forloop_index: locksmith_c88e_forloop__index,
            swatch_size: block_settings.swatch_size,
            swatch_image_width: swatch_image_width,
            sibling_product: sibling_product,
            option_name: settings.siblings_option_name,
            option_value: sibling_product.metafields.stiletto.sibling_option_name
          %}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{%- unless locksmith_67c7_product__has_only_default_variant -%}
  {%- liquid
    assign variant_popup_page = pages[block_settings.variant_popup_page]
    assign variant_popup_content_exists = false
    assign variant_popup_option = ''

    if block_settings.variant_popup_option != blank and block_settings.variant_popup_text != blank and variant_popup_page.content != blank
      assign variant_popup_content_exists = true
      assign variant_popup_option = block_settings.variant_popup_option | downcase
    endif
  -%}

  <div
    class="product__controls-group product__variants-wrapper product__block product__block--medium"
    data-enable-dynamic-product-options="{{ settings.enable_dynamic_product_options }}"
    data-current-variant-id="{{ locksmith_67c7_product__selected_or_first_available_variant.id }}"
    style="{{ swatch_style }}"
    {{ block.shopify_attributes }}
  >
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign option_name = option.name | downcase
        assign show_popup_trigger = false
        assign rendered_popup_trigger = ''
        assign option_values = ''

        if variant_popup_content_exists and option_name == variant_popup_option
          assign show_popup_trigger = true
        endif
      -%}
      
      {% if show_popup_trigger %}
        {% capture rendered_popup_trigger %}
          {%
            render 'product-block-information-popup' with
            block: block,
            popup_page_target: block_settings.variant_popup_page,
            popup_page: variant_popup_page,
            icon: block_settings.variant_popup_icon,
            custom_icon_image: block_settings.custom_icon_image,
            text: block_settings.variant_popup_text
          %}
        {% endcapture %}
      {% endif %}

      {% comment %}
        All inputs that have `name=options[Name]` will be picked up by
        ProductForm, registered as an option input, and made available
        at ProductForm.optionsInputs
      {% endcomment %}
      {%- capture option_values -%}
        <select
          id="option{{ option.position }}"
          name="options[{{ option.name | escape }}]"
          class="
            input
            {% if settings.enable_dynamic_product_options %}
              dynamic-variant-input
            {% endif %}
          "
          data-index="option{{ forloop.index }}"
        >
          {%- comment %}<locksmith:6119>{% endcomment -%}
            {%- assign locksmith_5930_forloop__size = 0 %}{%- for value in option.values -%}{% capture var %}{% render 'locksmith-variables', scope: 'subject', subject: value, subject_parent: option, variable: 'transparent' %}{% endcapture %}{% if var == 'true' %}{% assign locksmith_5930_forloop__size = locksmith_5930_forloop__size | plus: 1 %}{% endif %}{% endfor %}{% assign locksmith_5930_forloop__index = nil -%}
          {%- comment %}</locksmith:6119>{% endcomment -%}
          {%- for value in option.values -%}
            {%- comment %}<locksmith:ca0d>{% endcomment -%}
              {%- capture var %}{% render 'locksmith-variables', scope: 'subject', subject: value, subject_parent: option, variable: 'transparent' %}{% endcapture %}{% if var == "true" %}{% if locksmith_5930_forloop__index == nil %}{% assign locksmith_5930_forloop__index = 1 %}{% assign locksmith_5930_forloop__index0 = 0 %}{% else %}{% assign locksmith_5930_forloop__index = locksmith_5930_forloop__index | plus: 1 %}{% assign locksmith_5930_forloop__index0 = locksmith_5930_forloop__index0 | plus: 1 %}{% endif %}{% if locksmith_5930_forloop__index == 1 %}{% assign locksmith_5930_forloop__first = true %}{% else %}{% assign locksmith_5930_forloop__first = false %}{% endif %}{% if locksmith_5930_forloop__index == locksmith_5930_forloop__size %}{% assign locksmith_5930_forloop__last = true %}{% else %}{% assign locksmith_5930_forloop__last = false %}{% endif %}{% assign locksmith_5930_forloop__rindex = locksmith_5930_forloop__size | minus: locksmith_5930_forloop__index | minus: 1 %}{% assign locksmith_5930_forloop__rindex0 = locksmith_5930_forloop__size | minus: locksmith_5930_forloop__index0 | minus: 1 %}{% else %}{% continue %}{% endif -%}
            {%- comment %}</locksmith:ca0d>{% endcomment -%}
            <option
              data-value-handle="{{ value | handleize }}--{{ locksmith_5930_forloop__index }}"
              value="{{ value | escape }}"
              {%- if option.selected_value == value -%}
                selected="selected"
              {%- endif -%}
            >
              {{ value }}
            </option>
          {%- endfor -%}
        </select>
      {%- endcapture -%}

      {% capture rendered_option_inner %}
        {%- if swatch_options contains option_name -%}
          <!-- Handle swatches -->
          <div
            class="product__color-swatches"
            data-option-buttons
            data-product-option="option{{ option.position }}"
          >
            <div
              class="
                product__color-swatches--inner
                {% if settings.enable_dynamic_product_options %}
                  dynamic-variant-input-wrap
                {% endif %}
              "
              data-index="option{{ forloop.index }}"
            >
              {%- comment %}<locksmith:047b>{% endcomment -%}
                {%- assign locksmith_49f8_forloop__size = 0 %}{%- for value in option.values -%}{% capture var %}{% render 'locksmith-variables', scope: 'subject', subject: value, subject_parent: option, variable: 'transparent' %}{% endcapture %}{% if var == 'true' %}{% assign locksmith_49f8_forloop__size = locksmith_49f8_forloop__size | plus: 1 %}{% endif %}{% endfor %}{% assign locksmith_49f8_forloop__index = nil -%}
              {%- comment %}</locksmith:047b>{% endcomment -%}
              {%- for value in option.values -%}
                {%- comment %}<locksmith:70b1>{% endcomment -%}
                  {%- capture var %}{% render 'locksmith-variables', scope: 'subject', subject: value, subject_parent: option, variable: 'transparent' %}{% endcapture %}{% if var == "true" %}{% if locksmith_49f8_forloop__index == nil %}{% assign locksmith_49f8_forloop__index = 1 %}{% assign locksmith_49f8_forloop__index0 = 0 %}{% else %}{% assign locksmith_49f8_forloop__index = locksmith_49f8_forloop__index | plus: 1 %}{% assign locksmith_49f8_forloop__index0 = locksmith_49f8_forloop__index0 | plus: 1 %}{% endif %}{% if locksmith_49f8_forloop__index == 1 %}{% assign locksmith_49f8_forloop__first = true %}{% else %}{% assign locksmith_49f8_forloop__first = false %}{% endif %}{% if locksmith_49f8_forloop__index == locksmith_49f8_forloop__size %}{% assign locksmith_49f8_forloop__last = true %}{% else %}{% assign locksmith_49f8_forloop__last = false %}{% endif %}{% assign locksmith_49f8_forloop__rindex = locksmith_49f8_forloop__size | minus: locksmith_49f8_forloop__index | minus: 1 %}{% assign locksmith_49f8_forloop__rindex0 = locksmith_49f8_forloop__size | minus: locksmith_49f8_forloop__index0 | minus: 1 %}{% else %}{% continue %}{% endif -%}
                {%- comment %}</locksmith:70b1>{% endcomment -%}
                {% render 'product-swatch',
                  context: 'product-page',
                  prod: product,
                  forloop_index: locksmith_49f8_forloop__index,
                  swatch_size: block_settings.swatch_size,
                  swatch_image_width: swatch_image_width,
                  option_index: option.position,
                  option_name: option_name,
                  option_value: value,
                  selected_value: option.selected_value
                %}
              {%- endfor -%}

              {{ option_values }}
            </div>
          </div>
        {%- elsif chip_options contains option_name -%}
          <!-- Handle chips -->
          <div
            class="
              product__color-chips
              {% if settings.enable_dynamic_product_options %}
                dynamic-variant-input-wrap
              {% endif %}
            "
            data-option-buttons
            data-product-option="option{{ option.position }}"
            data-index="option{{ forloop.index }}"
            data-layout="{{ block_settings.chip_layout }}"
          >
            {%- comment %}<locksmith:9a54>{% endcomment -%}
              {%- assign locksmith_cbe5_forloop__size = 0 %}{%- for value in option.values -%}{% capture var %}{% render 'locksmith-variables', scope: 'subject', subject: value, subject_parent: option, variable: 'transparent' %}{% endcapture %}{% if var == 'true' %}{% assign locksmith_cbe5_forloop__size = locksmith_cbe5_forloop__size | plus: 1 %}{% endif %}{% endfor %}{% assign locksmith_cbe5_forloop__index = nil -%}
            {%- comment %}</locksmith:9a54>{% endcomment -%}
            {%- for value in option.values -%}
              {%- comment %}<locksmith:11d7>{% endcomment -%}
                {%- capture var %}{% render 'locksmith-variables', scope: 'subject', subject: value, subject_parent: option, variable: 'transparent' %}{% endcapture %}{% if var == "true" %}{% if locksmith_cbe5_forloop__index == nil %}{% assign locksmith_cbe5_forloop__index = 1 %}{% assign locksmith_cbe5_forloop__index0 = 0 %}{% else %}{% assign locksmith_cbe5_forloop__index = locksmith_cbe5_forloop__index | plus: 1 %}{% assign locksmith_cbe5_forloop__index0 = locksmith_cbe5_forloop__index0 | plus: 1 %}{% endif %}{% if locksmith_cbe5_forloop__index == 1 %}{% assign locksmith_cbe5_forloop__first = true %}{% else %}{% assign locksmith_cbe5_forloop__first = false %}{% endif %}{% if locksmith_cbe5_forloop__index == locksmith_cbe5_forloop__size %}{% assign locksmith_cbe5_forloop__last = true %}{% else %}{% assign locksmith_cbe5_forloop__last = false %}{% endif %}{% assign locksmith_cbe5_forloop__rindex = locksmith_cbe5_forloop__size | minus: locksmith_cbe5_forloop__index | minus: 1 %}{% assign locksmith_cbe5_forloop__rindex0 = locksmith_cbe5_forloop__size | minus: locksmith_cbe5_forloop__index0 | minus: 1 %}{% else %}{% continue %}{% endif -%}
              {%- comment %}</locksmith:11d7>{% endcomment -%}
              <button
                type="button"
                data-button
                data-label="{{ value | url_encode }}"
                aria-label="{{ value | replace: '"', "'" }}"
                data-option-value="{{ value | escape }}"
                data-option-handle="{{ value | handleize }}--{{ locksmith_cbe5_forloop__index }}"
                class="
                  product__chip
                  {% if option.selected_value == value %}
                    selected
                  {% endif %}
                  {% if settings.enable_dynamic_product_options %}
                    dynamic-variant-button
                  {% endif %}
                "
              >
                {{ value }}
              </button>
            {%- endfor -%}

            {{ option_values }}
          </div>
        {%- else -%}
          <div
            class="
              select-wrapper
              {% if settings.enable_dynamic_product_options %}
                dynamic-variant-input-wrap
              {% endif %}
            "
            data-index="option{{ forloop.index }}"
          >
            {{ option_values }}

            {% render 'icon' with icon: 'chevron-small' %}
          </div>
        {%- endif -%}
      {% endcapture %}

      {% capture rendered_option %}
        <div class="js-enabled product__option" data-product-option>
          <div class="product__label-wrapper">
            <label class="product__label fs-body-100" for="option{{ option.position }}">
              {%- assign optionDn = option.name | downcase -%}
              {%- if optionDn == 'quantity' -%}
                Pack Includes:&nbsp;
              {%- else -%}
                {{ option.name }}:&nbsp;
              {%- endif -%}
              <span class="t-opacity-70" data-selected-value-for-option data-option-name="option{{ option.position }}">
                {{- option.selected_value -}}
              </span>
            </label>
          </div>
          {{ rendered_option_inner }}
          {{ rendered_popup_trigger }}
        </div>
      {% endcapture %}

      {%- comment -%}Due to dynamic product options, options will be displayed in order of appearance{%- endcomment -%}
      {{ rendered_option }}
    {% endfor %}

    {%- if settings.enable_dynamic_product_options -%}
      <script type="application/json" data-variant-json>
        {%- comment %}<locksmith:9640>{% endcomment -%}
          {{- product.variants | json | replace: _67c7_unsafe_variants, _67c7_safe_variants -}}
          {%- comment %}original: {{ product.variants | json }}{%- endcomment %}
        {%- comment %}</locksmith:9640>{% endcomment -%}
      </script>
    {%- endif -%}
  </div>
{% endunless %}
{% if product.metafields.my_fields.ass != blank %}
  <div class="all_model_wrapper">
    {% assign recommended_products =  product.metafields.my_fields.ass.value %}
    {% for rProduct in recommended_products  %}
      {%- comment %}<locksmith:a6a5>{% endcomment -%}
        {%- capture var %}{% render 'locksmith-variables', scope: 'subject', subject: rProduct, variable: 'transparent' %}{% endcapture %}{% if var == "true" %}{% else %}{% continue %}{% endif -%}
      {%- comment %}</locksmith:a6a5>{% endcomment -%}
      <div class="other_model_box{% if current_variant.product.title == rProduct.title %} selected{% endif %}">
        <a href="{{ rProduct.url }}">
          {{rProduct.metafields.my_fields.size.value}}
          <div class="money">
            {{ rProduct.price  | money }}
          </div>
        </a>
      </div>
    {% endfor %}
  </div>
{% endif %}
{% comment %} {% if template == 'product' %} {% endcomment %}
{% if request.page_type == 'product' %}
<a
  class="product__information-popup product__block product__block--medium fs-body-75"
  id="product-candle-size-guide"
  href="javascript:void(0);"
>
  
    {%-
      render 'image' with
      wrapper_class: "product__information-popup-custom-icon",
      image: images['candle.svg'],
      sizes: "32px",
    -%}
  Candle Size guide
</a>
{% endif %}