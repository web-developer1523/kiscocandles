    "image_with_text_jFC67D": {
      "type": "image-with-text",
      "blocks": {
        "subheading_mckbY9": {
          "type": "subheading",
          "settings": {
            "subheading": "Elegant Bulk Pillar Candles for Wedding Decor",
            "subheading_tag": "h2",
            "subheading_font_class": "fs-heading-5-base"
          }
        },
        "border_i6tgzQ": {
          "type": "border",
