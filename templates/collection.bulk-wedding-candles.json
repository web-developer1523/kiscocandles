    "custom_liquid_iVBexh": {
      "type": "custom-liquid",
      "custom_css": [],
      "name": "t:sections.custom_liquid.presets.name",
      "settings": {
        "custom_liquid": "<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [{\n    \"@type\": \"Question\",\n    \"name\": \"Will Your Candles Leave Residue or Soot On My Table Linens?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"No. Our wholesale wedding candles are designed to burn clean without messy wax drips, soot, or harsh odors. No globs. No smells. Just glow.\"\n    }\n  },{\n    \"@type\": \"Question\",\n    \"name\": \"Can I Mix Different Candle Sizes in a Single Order?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"Absolutely. You can customize your order with any combination of styles and sizes that best fit your décor needs.\"\n    }\n  },{\n    \"@type\": \"Question\",\n    \"name\": \"How Far in Advance Should I Place a Bulk Wedding Candle Order?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"We recommend placing your order 2–3 weeks before your event. That gives you plenty of time for shipping, setup, and peace of mind.\"\n    }\n  },{\n    \"@type\": \"Question\",\n    \"name\": \"Do You Ship Directly to Venues or Event Locations?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"Yes, we can ship directly to your venue or planner—just make sure to enter the correct delivery address during checkout.\"\n    }\n  },{\n    \"@type\": \"Question\",\n    \"name\": \"Do You Offer Discounts on Large Orders?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"Yes. The more you buy, the more you save. Bulk pricing gets better as your quantity goes up—ideal for weddings and large-scale events.\"\n    }\n  }]\n}\n</script>",
        "divider_style": "none",
        "section_padding": "section--vertical-padding-top-bottom"
      }
    },
    "rich_text_p7D8ce": {
      "type": "rich-text",
      "blocks": {
