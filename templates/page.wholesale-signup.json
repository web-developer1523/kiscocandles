e returned in their original condition and packaging, accompanied by a receipt or proof of purchase. Returns must be requested by contacting support to ensure eligibility and instructions.\"\n      }\n    }\n  ]\n}\n</script>\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": [\"Organization\", \"WholesaleStore\"],\n  \"name\": \"Kisco Candles\",\n  \"alternateName\": \"Kisco\",\n  \"url\": \"https://kiscocandles.com/pages/wholesale\",\n  \"logo\": \"https://kiscocandles.com/cdn/shop/files/Logo.svg?v=1714200371\",\n  \"description\": \"At Kisco Candles, we don’t just supply candles; we provide quality, dependable service, and a diverse selection to meet the highest standards. Whether you’re a retailer, event planner, restaurant, or florist, our wholesale candle program offers more—more quality, options, and support—all at competitive prices to stretch your budget further.\",\n  \"telephone\": \"732-405-3566\",\n  \"priceRange\": \"$$\",\n  \"image\": \"https://kiscocandles.com/cdn/shop/files/Logo.svg?v=1714200371\",\n  \"contactPoint\": {\n    \"@type\": \"ContactPoint\",\n    \"telephone\": \"732-405-3566\",\n    \"contactType\": \"customer service\",\n    \"areaServed\": \"US\",\n    \"availableLanguage\": \"en\"\n  },\n  \"address\": {\n    \"@type\": \"PostalAddress\",\n    \"streetAddress\": \"4475 South Clinton Ave\",\n    \"addressLocality\": \"South Plainfield\",\n    \"addressRegion\": \"NJ\",\n    \"postalCode\": \"07080\",\n    \"addressCountry\": \"US\"\n  },\n  \"sameAs\": \"https://www.facebook.com/people/Kisco-Candles/100089858626778/\",\n  \"@graph\": [\n    {\n      \"@type\": \"WebPage\",\n      \"url\": \"https://kiscocandles.com/pages/wholesale\",\n      \"name\": \"Kisco Candles\",\n      \"description\": \"Purchase unscented candles for events and more at Kisco Candles. We bring you only premium, high-quality decorative candles that look beautiful and burn perfectly. Order bulk candles for sale online at Kisco Candles today.\"\n    }\n  ],\n  \"hasOfferCatalog\": {\n    \"@type\": \"OfferCatalog\",\n    \"name\": \"Wholesale Candle Collections\",\n    \"itemListElement\": [\n      {\n        \"@type\": \"ListItem\",\n        \"name\": \"Wholesale Unscented Candles\"\n      },\n      {\n        \"@type\": \"ListItem\",\n        \"name\": \"Wholesale Candles\"\n      },\n      {\n        \"@type\": \"ListItem\",\n        \"name\": \"Wholesale Wedding Candles\"\n      },\n      {\n        \"@type\": \"ListItem\",\n        \"name\": \"Wholesale Scented Candles\"\n      },\n      {\n        \"@type\": \"ListItem\",\n        \"name\": \"Wholesale Colored Candles\"\n      },\n      {\n        \"@type\": \"ListItem\",\n        \"name\": \"Wholesale Bolsius Candles\"\n      }\n    ]\n  }\n}\n</script>",
