        "mobile_height": 50,
        "image": "shopify://shop_images/wholesale-bolsius-candles.png",
        "focal_point": "image_presentation",
        "mobile_focal_point": "image_presentation",
        "media_link": "",
        "text_position": "center_center",
        "text_position_mobile": "center_center",
