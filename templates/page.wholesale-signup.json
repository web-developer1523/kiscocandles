    "collapsible_row_list_fYERVb": {
      "type": "collapsible-row-list",
      "blocks": {
        "item_4HGWFy": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
            "icon": "none",
            "title": "Where can I use your candles?",
            "text": "<p>Our candles can be used indoors and outdoors.</p>"
          }
        },
        "item_RqwC7P": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
            "icon": "none",
            "title": "How do I make sure the candles don't smoke?",
            "text": "<p>Once you ensure that the candles are steadily in the holder, melt the bottom of the candle. This will act as an adhesive and keep the candle in a safe, upright position. Make sure there are no gusts of air that can blow on it, for example, a window draft, fan, AC unit, or if it’s a windy day.</p><p>Please keep in mind that even with these precautions in place, candles can still drip. If used as directed, Kisco candles should burn evenly and smoothly.</p>"
          }
        },
        "item_VXp3mt": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
            "icon": "none",
            "title": "How do I make sure the candles don't smoke?",
            "text": "<p>The candles should not be any closer than three inches from one another to avoid the flames from getting too close and creating a smoking condition.</p>"
          }
        }
      },
