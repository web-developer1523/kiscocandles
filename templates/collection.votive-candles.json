          "settings": {}
        },
        "text_G7eEn9": {
          "type": "text",
          "settings": {
            "text": "<p>Our collection of <strong>votive candles</strong> is designed to be versatile, stylish, and practical.</p><p>These <strong>votive candles</strong> are unscented, which makes them ideal for tablescapes, food service areas, or gatherings where fragrance might be a distraction. Each votive delivers a clean, steady flame, perfect for restaurants, weddings, or everyday ambiance.</p><p>Available in long-burning formats like 6-hour and 24-hour options, our <strong>votives</strong> are easy to place in standard holders, glass containers, or decorative lanterns.<br/><br/></p>",
            "text_font_class": "fs-body-75"
          }
        }
      },
      "block_order": [
        "subheading_4W4pwU",
        "border_7FLkyj",
        "text_G7eEn9"
      ],
      "custom_css": [
