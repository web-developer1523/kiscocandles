    "image_with_text_YFy6rM": {
      "type": "image-with-text",
      "blocks": {
        "subheading_4W4pwU": {
          "type": "subheading",
          "settings": {
            "subheading": "Explore Our Full Range of Votive Candles",
            "subheading_tag": "h2",
