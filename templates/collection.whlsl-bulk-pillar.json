    "image_hero_bVXrJA": {
      "type": "image-hero",
      "blocks": {
        "heading_rbKkW6": {
          "type": "heading",
          "settings": {
            "title": "Wholesale Bulk Pillar Candles: Easy to Order, Easy to Trust",
            "heading_tag": "h2",
            "heading_font_class": "fs-heading-display-2"
          }
        },
        "text_htqMc8": {
          "type": "text",
          "settings": {
            "text": "<p>At Kisco, we make buying wholesale bulk pillar candles simple and stress-free. Our streamlined wholesale portal is designed to help you find exactly what you need, with options to suit events, churches, and businesses of all sizes. Enjoy the convenience of bulk pricing, flexible order quantities, and fast, reliable delivery. Whether you’re stocking shelves or planning a large ceremony, you can count on Kisco to provide high-quality candles that meet your needs without compromise.</p>",
            "text_font_class": "fs-body-100"
          }
        },
        "button_kDkMbB": {
          "type": "button",
          "settings": {
            "link": "https://kiscocandles.com/collections/wholesale-bulk-candles",
