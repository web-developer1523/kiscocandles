        },
        "text_bhy8pe": {
          "type": "text",
          "settings": {
            "text": "<p>From classic white to bold hues, Kisco’s taper candles come in a <a href=\"https://kiscocandles.com/pages/shop-by-color\"><span style=\"text-decoration:underline\">variety of colors</span></a> to match any theme or décor. With multiple sizes available, it’s easy to find the perfect fit for everything from towering centerpieces to subtle accents. This versatility makes them a favorite for planners and buyers looking to get the most out of their bulk purchases.</p>",
            "text_font_class": "fs-body-100"
          }
        },
