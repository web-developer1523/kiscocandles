    "image_with_text_EgWHpD": {
      "type": "image-with-text",
      "blocks": {
        "subheading_g4FYKe": {
          "type": "subheading",
          "settings": {
            "subheading": "Bulk Taper Candles for Events, Restaurants & Retail",
            "subheading_tag": "h2",
