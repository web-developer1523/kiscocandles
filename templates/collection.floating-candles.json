            "subheading_font_class": "fs-heading-5-base"
          }
        },
        "text_y6Nnxf": {
          "type": "text",
          "settings": {
            "text": "<p><strong>With Kisco Candles, elegance is just a candlelight away. </strong>Whether enhancing a romantic dinner or adding splendor to your celebrations, <strong>our floating candles promise to make every moment memorable.</strong> Browse our collections and find the perfect glow to match your mood and décor. Let Kisco illuminate your next event and steal the show. </p>",
            "text_font_class": "fs-body-100"
          }
        },
        "button_QUbFdy": {
