        },
        "text_cVFhCr": {
          "type": "text",
          "settings": {
            "text": "<p>At Kisco Candles, you can find bulk tea lights in both aluminum and clear cups, with multiple burn-time options to suit different uses. That gives you flexibility for event work, restaurant service, hospitality settings, and everyday decorative use.</p>",
            "text_font_class": "fs-body-75"
