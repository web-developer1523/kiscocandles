    "custom_liquid_KzKEmh": {
      "type": "custom-liquid",
      "name": "t:sections.custom_liquid.presets.name",
      "settings": {
        "custom_liquid": "<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [{\n    \"@type\": \"Question\",\n    \"name\": \"How many tea lights are included in your bulk packs?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"We offer options such as 96, 144, and 288 for long-burning clear cup tea lights, and 3.5-hour bulk tea lights in packs containing from 300 to 1000 candles.\"\n    }\n  },{\n    \"@type\": \"Question\",\n    \"name\": \"Are your bulk tealights truly dripless?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"Yes. Our tea light candles are made with stable wax and well-centered wicks to burn clean without dripping, when used in appropriate holders.\"\n    }\n  },{\n    \"@type\": \"Question\",\n    \"name\": \"Can I use these outdoors?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"You can, but keep them shielded from the wind. Use hurricane holders or enclosed lanterns to keep the flame steady.\"\n    }\n  },{\n    \"@type\": \"Question\",\n    \"name\": \"Do you offer different burn times in your bulk tealight candles?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"Yes. Choose from 3.5 or 8-hour options based on your needs. All are designed to burn evenly from start to finish.\"\n    }\n  }]\n}\n</script>",
        "divider_style": "none",
        "section_padding": "section--vertical-padding-top-bottom"
      }
    },
