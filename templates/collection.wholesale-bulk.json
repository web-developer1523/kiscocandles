    "image_with_text_wczNfd": {
      "type": "image-with-text",
      "blocks": {
        "subheading_8AQM3k": {
          "type": "subheading",
          "settings": {
            "subheading": "Wholesale Candles for Events, Restaurants, and Weddings",
            "subheading_tag": "h2",
            "subheading_font_class": "fs-heading-5-base"
