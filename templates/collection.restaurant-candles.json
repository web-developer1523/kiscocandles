      }
    },
    "rich_text_6FD3W6": {
      "type": "rich-text",
      "blocks": {
        "image_8QN7BE": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/restaurant-candles_6a4fac03-3b22-41f6-b873-aa254077718a.jpg",
            "content_width": "full",
            "image_size": 1000,
            "image_size_mobile": 200
          }
        }
      },
      "block_order": [
        "image_8QN7BE"
