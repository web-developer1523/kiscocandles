        "text_KtxPpW": {
          "type": "text",
          "settings": {
            "text": "<p>Below are answers to some common questions about restaurant candles. Our knowledgeable staff is always happy to help – if you have additional questions, please <a href=\"https://kiscocandles.com/pages/contact-us\"><span style=\"text-decoration:underline\">contact us</span></a>. </p>",
