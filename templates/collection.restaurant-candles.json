    "rich_text_NAaNX4": {
      "type": "rich-text",
      "blocks": {
        "heading_W8ijHH": {
          "type": "heading",
          "settings": {
            "title": "Dining Experiences Made More Elegant With Premium Restaurant Candles",
            "heading_tag": "h2",
            "heading_font_class": "fs-heading-2-base"
          }
        },
        "text_4Td7EC": {
          "type": "text",
          "settings": {
            "text": "<p><strong>Enhance the ambiance of your dining establishment with our exquisite restaurant candles.</strong> Kisco Candles offers a variety of restaurant table candles designed to complement any décor while setting a warm, inviting atmosphere for your guests. From intimate bistros to fine dining venues, our candles for restaurants provide the ideal balance of elegance and functionality, so that every meal is memorable. </p>",
            "text_font_class": "fs-body-100"
          }
        }
      },
      "block_order": [
        "heading_W8ijHH",
        "text_4Td7EC"
      ],
      "settings": {
