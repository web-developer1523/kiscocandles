    "image_hero_gyLjgx": {
      "type": "image-hero",
      "blocks": {
        "subheading_wBaypB": {
          "type": "subheading",
          "settings": {
            "subheading": "Illuminate Your Next Event With Bulk Floating Candles From Kisco",
            "subheading_tag": "h2",
            "subheading_font_class": "fs-heading-5-base"
          }
        },
        "text_y6Nnxf": {
          "type": "text",
          "settings": {
            "text": "<p><strong>To set the mood and make a lasting impression at your next big event, make sure our bulk floating candles are on the guest list.</strong> Browse our collection today and find the perfect match for your theme and budget. Whether for resale or décor, our candles promise quality and elegance that will leave guests mesmerized.</p>",
