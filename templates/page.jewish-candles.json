    "rich_text_iJFLDY": {
      "type": "rich-text",
      "blocks": {
        "text_mfJL6G": {
          "type": "text",
          "settings": {
            "text": "<p>Jewish candles are used throughout the year for weekly observance, holiday gatherings, and remembrance. Whether you're preparing for Shabbat, marking a Yahrzeit anniversary, or observing Yizkor, each moment calls for a specific type of candle. This hub brings the three main categories together so you can shop by occasion without sorting through unrelated products.</p><p>Start with Shabbat candles for Friday night candle lighting. Move to Yahrzeit candles for marking the anniversary of a loss. Or shop Yizkor candles for memorial services observed four times a year. All three categories are here, with practical guidance to help you choose the right style and burn time for your setting.</p>",
            "text_font_class": "fs-body-100"
          }
        }
      },
      "block_order": [
        "text_mfJL6G"
      ],
      "name": "t:sections.rich_text.presets.name",
      "settings": {
        "alignment": "left_left",
        "enable_animation": true,
        "divider_style": "none",
