    "custom_liquid_eYYxjA": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom_liquid.presets.name",
      "settings": {
        "custom_liquid": "<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [\n    {\n      \"@type\": \"Question\",\n      \"name\": \"What's the difference between Shabbat candles and memorial candles?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Shabbat candles are lit to welcome the Sabbath and typically burn for about 4 hours on Friday evenings. Memorial candles, including Yahrzeit and Yizkor candles, are intended to burn much longer, often through a full 24-hour period, as a way of honoring the memory of someone who has passed. The two serve distinct purposes and are generally not interchangeable.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Which page should I shop for a Yahrzeit candle?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Head to the Yahrzeit Candles category page. You'll find options organized by burn time and format, including 24-hour candles in glass and multipacks for family use.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Which page should I shop for a Yizkor candle?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Visit the Yizkor Candles category page. That section covers memorial candles specifically suited for the four annual Yizkor observances, with guidance on burn time and setup.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Do you offer bulk ordering for synagogues and events?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Yes. Bulk and wholesale pricing is available for synagogues, community organizations, and event planners. Reach out through the contact page with your quantity needs, and we'll get back to you with options.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Are most Jewish candles unscented?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"The majority of Jewish candles sold for religious use are unscented by design. This is particularly important for Shabbat dinner tables and holiday gatherings where food is being served. Fragrance in that setting can be distracting. Our Jewish candle categories focus on unscented options suited to these occasions.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Can I use Shabbat candles for a Yahrzeit or Yizkor observance?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Shabbat tapers are not typically the right fit for Yahrzeit or Yizkor because they aren't designed to burn for 24 hours. A standard taper burns for a much shorter time. For those observances, a dedicated memorial candle, often a glass-contained format, is the more appropriate choice.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How many candles do I need for Shabbat?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Most households light two Shabbat candles as the traditional minimum. Some families light additional candles for each family member or child. There is no single rule, so the quantity often comes down to family custom.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Are these candles appropriate for synagogue use?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Yes. Our candles from all three categories, Shabbat, Yahrzeit, and Yizkor, are used in synagogue settings. For synagogue purchasing, bulk ordering is the practical path since you'll be managing multiple occasions and regular restocking needs.\"\n      }\n    }\n  ]\n}\n</script>",
        "divider_style": "none",
        "section_padding": "section--vertical-padding-top-bottom"
      }
    },
    "collapsible_row_list_9yGJyW": {
