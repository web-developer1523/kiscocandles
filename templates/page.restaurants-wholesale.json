    "image_hero_rfgMHy": {
      "type": "image-hero",
      "blocks": {
        "heading_dTLyBj": {
          "type": "heading",
          "settings": {
            "title": "Join for Exclusive Wholesale Savings",
            "heading_tag": "h2",
            "heading_font_class": "fs-heading-display-1"
          }
        },
        "text_BULzd6": {
          "type": "text",
          "settings": {
            "text": "<p>Experience the benefits of partnering with Kisco Candles for your wholesale needs. By signing up for a wholesale account, your business gains access to exclusive advantages designed to save you time and money. Sign up to unlock custom pricing, easy reordering, free shipping on qualifying orders, dedicated support, and a 30-day return policy. </p><p>Ready to simplify your candle orders? Join us today for reliable quality and exceptional service.</p><p>Ready to streamline your candle supply? Sign up today and enjoy the reliability and quality Kisco Candles brings to every order, backed by exceptional support and secure purchasing options.</p>",
            "text_font_class": "fs-body-100"
          }
        },
        "button_4jMd4t": {
          "type": "button",
          "settings": {
            "link": "#shopify-section-template--15956997603437__rich_text_hPbJTd",
            "link_text": "Sign Up Today",
            "button_style": "btn--secondary"
          }
        }
      },
      "block_order": [
