        "text_phgQQw": {
          "type": "text",
          "settings": {
            "text": "<p>Choosing the perfect <a href=\"https://www.marthastewart.com/7945966/candle-wedding-ideas\"><span style=\"text-decoration:underline\">candles for your wedding</span></a> is essential to creating the right ambiance. Here, we've answered some of the most common questions about the Bolsius wedding candles we offer. If you need additional information, please <a href=\"https://kiscocandles.com/pages/contact-us\"><span style=\"text-decoration:underline\">contact us</span></a>.</p>",
