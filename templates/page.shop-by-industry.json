      "blocks": {
        "item_BF7eX3": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
            "icon": "none",
            "title": "Wholesale Account Discounts",
            "text": "<p>Unlock more value by setting up a <a href=\"https://kiscocandles.com/pages/wholesale\"><span style=\"text-decoration:underline\">wholesale account</span></a> with Kisco Candles. You'll enjoy exclusive discounts and pricing tailored to bulk purchases. Plus, you can easily reorder your favorite products and keep track of your order history with our user-friendly account dashboard.</p>"
          }
        },
        "item_7bnyzR": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
            "icon": "none",
            "title": " Dedicated Support for Your Business",
            "text": "<p>Get personalized service and support from your dedicated account manager who understands your business. We're here to assist you with any questions, product recommendations, or order management needs. Not sure which candles are right for your business? Our experts are ready to help you choose the best options to suit your specific environment and goals.</p>"
          }
        },
        "item_ihkdN8": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
            "icon": "none",
            "title": "Fast & Free Shipping",
            "text": "<p>All domestic orders of $199.99 or more qualify for free standard shipping, ensuring your candles arrive promptly without extra expense. In addition, orders placed before 2PM ET, Monday to Thursday, are typically shipped the same or next day.</p>"
          }
        },
        "item_kYBDXq": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
            "icon": "none",
            "title": "30-Day Return Policy",
            "text": "<p>Purchase with confidence, knowing that you can <a href=\"https://kiscocandles.com/pages/return-policy\"><span style=\"text-decoration:underline\">return products within 30 days</span></a> if they don’t meet your expectations.</p><p>Sign up for all the benefits our <a href=\"https://kiscocandles.com/pages/wholesale\"><span style=\"text-decoration:underline\">wholesale membership</span></a> provides today.</p>"
          }
        }
      },
