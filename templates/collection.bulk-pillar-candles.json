        "custom_liquid": "<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [\n    {\n      \"@type\": \"Question\",\n      \"name\": \"What makes your bulk pillar candles a great choice for events and businesses?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Our bulk candles are made by a company called Bolsius. They're known for their high-quality craftsmanship and features that appeal to business owners and their patrons. Bolsius bulk candles are dripless, smokeless and unscented, making them ideal for various events and venues. Their long burn time and clean appearance ensure that your décor remains flawless throughout the event.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Do bulk pillar candles come in different sizes?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Yes, bulk pillar candles are available in various widths (between 2\\\" and 3\\\") and heights (up to 9\\\") to suit different needs. From large statement pieces to smaller candles for intimate settings, we have high-quality, affordable pillar candles to illuminate your space.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Can I order customized quantities for bulk purchases?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Absolutely! Through our wholesale program, we provide flexible bulk order options so you can customize the quantities to fit your specific needs for any event or business setup.\"\n      }\n    }\n  ]\n}\n</script>",
        "divider_style": "none",
