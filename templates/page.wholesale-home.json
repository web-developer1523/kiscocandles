    "testimonials_maibDB": {
      "type": "testimonials",
      "blocks": {
        "testimonial_8B6KwC": {
          "type": "testimonial",
          "settings": {
            "product": "",
            "image_position": "right",
            "image": "shopify://shop_images/profile_a131cb66-58b0-4f79-8cef-b9300d2f6236.png",
            "aspect_ratio": "square",
            "focal_point": "image_presentation",
            "show_rating": true,
            "rating": 5,
            "quote": "\"Kisco candles has been my go-to place for all my bulk candle orders, they offer great quality & service and very quick turnaround time.\"",
            "author": "– Owner of Joe Flohr Events"
          }
        },
        "testimonial_9YEgCW": {
          "type": "testimonial",
          "settings": {
            "product": "",
            "image_position": "right",
            "image": "shopify://shop_images/profile_a131cb66-58b0-4f79-8cef-b9300d2f6236.png",
            "aspect_ratio": "square",
            "focal_point": "image_presentation",
            "show_rating": true,
            "rating": 5,
            "quote": "\"For my wife and I, candles aren't just for special occasions; we live our lives by candlelight. After trying the usual e-commerce sites, we came across Kisco Candles and have been buying from them ever since. Kisco sells top-quality Bolsius dripless candles at a very competitive price, and their dedication to customer service is as good as I have ever experienced \"",
            "author": "– David B. Roaring Branch, PA"
          }
        },
        "testimonial_mJfDir": {
          "type": "testimonial",
          "settings": {
            "product": "",
            "image_position": "right",
            "image": "shopify://shop_images/profile_a131cb66-58b0-4f79-8cef-b9300d2f6236.png",
            "aspect_ratio": "square",
            "focal_point": "image_presentation",
            "show_rating": true,
            "rating": 5,
            "quote": "\"Kisco has been so helpful for us, super speedy service, best pricing we can find and very reliable. We use a lot of candles every day, so it's very important to have a business we can consistently rely on!\"",
            "author": "– Nathan Rawlinson General Manager At stissing house restaurant"
          }
        },
        "testimonial_7D7wMg": {
          "type": "testimonial",
          "settings": {
            "product": "",
            "image_position": "right",
            "image": "shopify://shop_images/profile_a131cb66-58b0-4f79-8cef-b9300d2f6236.png",
            "aspect_ratio": "square",
            "focal_point": "image_presentation",
            "show_rating": true,
            "rating": 5,
            "quote": "\"Runing a busy restaurant that candles is part of the table setting, I need to have high quality candles yet for a great price, And Kisco candles has my back always in stock and fast shipping, so I don’t need to stock them by the pallet I just order them as needed!\"",
            "author": "– Jeneel N. Floor Manager At Léon 1909"
          }
        },
        "testimonial_7Dq8gi": {
          "type": "testimonial",
          "settings": {
            "product": "",
            "image_position": "right",
            "image": "shopify://shop_images/profile_a131cb66-58b0-4f79-8cef-b9300d2f6236.png",
            "aspect_ratio": "natural",
            "focal_point": "image_presentation",
            "show_rating": true,
            "rating": 5,
            "quote": "\"The Bolsius Pillars candle is a high-quality candle that burns evenly with no MESS like so many other candles that I've tried. I started buying them from Kisco other branch, but determined that Kisco main website delivers faster, and my candles always arrives healthy, and Kisco always helps to get your order straight, and that's from my experience. The Bolsius Candles are excellent for my prayers. I have been ordering from Kisco for a few years now.\"",
            "author": "– Antonius Asanto"
          }
        },
        "testimonial_CLwTbV": {
          "type": "testimonial",
          "settings": {
            "product": "",
            "image_position": "right",
            "image": "shopify://shop_images/profile_a131cb66-58b0-4f79-8cef-b9300d2f6236.png",
            "aspect_ratio": "square",
            "focal_point": "image_presentation",
            "show_rating": true,
            "rating": 5,
            "quote": "\"Being the owner of a large flower shop that uses candles as part of my arrangement’s and table design, I was looking for a place that can provide Quality , Price , Selection & Service all under one roof, and yes kisco candles has all of them by far, I love to deal with them highly recommended.\"",
            "author": "– C. Brodt Owner of stems flower NY"
          }
        }
      },
      "block_order": [
        "testimonial_8B6KwC",
