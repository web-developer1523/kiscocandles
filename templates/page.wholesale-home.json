    "collapsible_row_list_with_contact_bzKPML": {
      "type": "collapsible-row-list-with-contact",
      "blocks": {
        "item_kcw4Pe": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
            "icon": "none",
            "title": "Do You Offer Bulk Purchase Discounts for Businesses?",
            "text": "<p>Yes, Kisco Candles offers volume discounts on wholesale orders. The more you purchase, the bigger the discount. Contact our sales team for more information on pricing tiers and custom bulk orders.</p>"
          }
        },
        "item_DwfAyP": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
            "icon": "none",
            "title": "What Is Your Return Policy?",
            "text": "<p>Our return policy allows for returns of defective or damaged products within 30 days of receipt. If you aren't satisfied with your purchase, please get in touch with our customer service team to initiate a return and for further assistance.</p>"
          }
        },
        "item_3FT3Ua": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
            "icon": "none",
            "title": "What Are Your Shipping Options and Delivery Times?",
            "text": "<p>Kisco Candles offers free shipping on all orders over $99.99 order below $99.99 have a flat fee of $6.99 nationwide . Delivery times for bulk orders depend on the order size and destination. We aim to fulfill orders promptly and will provide an estimated delivery timeline upon order confirmation.</p>"
          }
        },
        "item_LWM6hC": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
            "icon": "none",
            "title": "How Long Do Your Candles Burn?",
            "text": "<p>The burn times of our candles vary from six to 116 hours, depending on the type and size of the candle. Detailed burn times are provided in our product descriptions.</p>"
          }
        },
        "item_RGmyqB": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
            "icon": "none",
            "title": "What Are Bolsius Candles Made Of?",
            "text": "<p>Bolsius unscented candles are made from high-quality plant-based wax and feature braided cotton wicks. Materials are carefully selected to ensure a clean and even burn.</p>"
          }
        }
      },
      "block_order": [
        "item_kcw4Pe",
        "item_DwfAyP",
