        "heading_ECE7pH": {
          "type": "heading",
          "settings": {
            "title": "Discover the Quality of Bolsius Scentless Candles",
            "heading_tag": "h2",
            "heading_font_class": "fs-heading-display-2"
          }
        },
        "text_gUtEFW": {
          "type": "text",
          "settings": {
            "text": "<p>At Kisco, we carry <a href=\"https://kiscocandles.com/collections/bolsius-candles\"><span style=\"text-decoration:underline\">Bolsius Candles</span></a>, a renowned European brand trusted for its consistent quality, clean burn, and refined design. Made with care and precision, Bolsius products use high-grade wax blends and cotton wicks for a dripless, smokeless experience. Whether you're setting the mood or lighting up a space with purpose, Bolsius delivers beauty without distraction.</p>",
            "text_font_class": "fs-body-100"
          }
        }
