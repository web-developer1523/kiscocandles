      "name": "t:sections.custom_liquid.presets.name",
      "settings": {
        "custom_liquid": "<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How many Shabbat candles should I order?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Most households light two candles per week, so a standard calculation is two candles multiplied by the number of weeks you want to stock for. If you light additional candles per family member, adjust accordingly. Many households order in sets of 12 or 24 pairs to simplify restocking.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"What size Shabbat taper fits most candlesticks?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Standard Shabbat tapers are designed to fit the most common candlestick holder openings, but holders do vary in size. A quick measurement of your holder's opening before ordering helps confirm the right fit. Most standard tapers have a diameter between 7/8 inch and 1 inch at the base.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Are Shabbat candles unscented?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Yes, Shabbat candles intended for religious use are unscented. Fragrance at a dinner table competes with food, which is why unscented is the standard for this category. All options in this collection are unscented.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Can I use Shabbat candles in glass holders?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Tapers are designed for open candlestick holders, not enclosed glass containers. If your holder has a tall glass chimney with an open top and a socket at the base, a taper may work depending on the dimensions. Fully enclosed glass containers are better suited to votive-style or memorial candles.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Do Shabbat candles drip?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Some dripping is normal with taper candles, and it's influenced by placement, airflow, and wick condition. Keeping candles away from drafts and trimming the wick before each use significantly reduces dripping. Many of our Shabbat tapers are formulated for low-drip performance.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Can I order Shabbat candles in bulk for a synagogue?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Yes. Bulk ordering for synagogues and community organizations is available. Contact us with your quantity needs, and we'll walk you through wholesale options for regular restocking.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"What's the difference between Shabbat candles and taper candles?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Shabbat candles are a specific category of taper candles designed for religious use, always unscented, in appropriate heights for standard holders, and made with burn performance in mind for the Friday night table. Not all taper candles are made to these standards.\"\n      }\n    }\n  ]\n}\n</script>",
        "divider_style": "none",
        "section_padding": "section--vertical-padding-top-bottom"
      }
    },
    "rich_text_p7D8ce": {
      "type": "rich-text",
      "blocks": {
        "spacer_L8mYri": {
          "type": "spacer",
          "settings": {
            "space": 40
          }
        },
        "heading_MrGjAB": {
          "type": "heading",
          "settings": {
            "title": "Frequently Asked Questions",
            "heading_tag": "h2",
            "heading_font_class": "fs-heading-3-base"
          }
        },
        "spacer_NejAJW": {
          "type": "spacer",
          "settings": {
            "space": 16
          }
        },
        "subheading_jRWLhL": {
          "type": "subheading",
          "settings": {
            "subheading": "How many Shabbat candles should I order?",
            "subheading_tag": "h3",
            "subheading_font_class": "fs-heading-6-base"
          }
        },
        "text_cVFhCr": {
          "type": "text",
          "settings": {
            "text": "<p>Most households light two candles per week, so a standard calculation is two candles multiplied by the number of weeks you want to stock for. If you light additional candles per family member, adjust accordingly. Many households order in sets of 12 or 24 pairs to simplify restocking.</p>",
            "text_font_class": "fs-body-75"
          }
        },
        "spacer_ykeVbb": {
          "type": "spacer",
          "settings": {
            "space": 16
          }
        },
        "subheading_fVaWkq": {
          "type": "subheading",
          "settings": {
            "subheading": "What size Shabbat taper fits most candlesticks?",
            "subheading_tag": "h3",
            "subheading_font_class": "fs-heading-6-base"
          }
        },
        "spacer_68L9WH": {
          "type": "spacer",
          "settings": {
            "space": 16
          }
        },
        "text_xVMDY7": {
          "type": "text",
          "settings": {
            "text": "<p>Standard Shabbat tapers are designed to fit the most common candlestick holder openings, but holders do vary in size. A quick measurement of your holder's opening before ordering helps confirm the right fit. Most standard tapers have a diameter between 7/8 inch and 1 inch at the base.</p>",
            "text_font_class": "fs-body-75"
          }
        },
        "subheading_63Jihh": {
          "type": "subheading",
          "settings": {
            "subheading": "Are Shabbat candles unscented?",
            "subheading_tag": "h3",
            "subheading_font_class": "fs-heading-6-base"
          }
        },
        "text_dttHE3": {
          "type": "text",
          "settings": {
            "text": "<p>Yes, Shabbat candles intended for religious use are unscented. Fragrance at a dinner table competes with food, which is why unscented is the standard for this category. All options in this collection are unscented.</p>",
            "text_font_class": "fs-body-75"
          }
        },
        "spacer_7QXgMW": {
          "type": "spacer",
          "settings": {
            "space": 40
          }
        },
        "subheading_CaB7m3": {
          "type": "subheading",
          "settings": {
            "subheading": "Can I use Shabbat candles in glass holders?",
            "subheading_tag": "h3",
            "subheading_font_class": "fs-heading-6-base"
          }
        },
        "text_Cr96Tc": {
          "type": "text",
          "settings": {
            "text": "<p>Tapers are designed for open candlestick holders, not enclosed glass containers. If your holder has a tall glass chimney with an open top and a socket at the base, a taper may work depending on the dimensions. Fully enclosed glass containers are better suited to votive-style or memorial candles.</p>",
            "text_font_class": "fs-body-75"
          }
        },
        "spacer_M38WhA": {
          "type": "spacer",
          "settings": {
            "space": 40
          }
        },
        "subheading_XbgxMh": {
          "type": "subheading",
          "settings": {
            "subheading": "Do Shabbat candles drip?",
            "subheading_tag": "h3",
            "subheading_font_class": "fs-heading-6-base"
          }
        },
        "text_4G8gEk": {
          "type": "text",
          "settings": {
            "text": "<p>Some dripping is normal with taper candles, and it's influenced by placement, airflow, and wick condition. Keeping candles away from drafts and trimming the wick before each use significantly reduces dripping. Many of our Shabbat tapers are formulated for low-drip performance.</p>",
            "text_font_class": "fs-body-75"
          }
        },
        "spacer_E8NYJk": {
          "type": "spacer",
          "settings": {
            "space": 40
          }
        },
        "subheading_ii8cXH": {
          "type": "subheading",
          "settings": {
            "subheading": "Can I order Shabbat candles in bulk for a synagogue?",
            "subheading_tag": "h3",
            "subheading_font_class": "fs-heading-6-base"
          }
        },
        "text_xECmzw": {
          "type": "text",
          "settings": {
            "text": "<p>Yes. Bulk ordering for synagogues and community organizations is available. Contact us with your quantity needs, and we'll walk you through wholesale options for regular restocking.</p>",
            "text_font_class": "fs-body-75"
          }
        },
        "spacer_R68zwt": {
          "type": "spacer",
          "settings": {
            "space": 40
          }
        },
        "subheading_wAxEbj": {
          "type": "subheading",
          "settings": {
            "subheading": "What's the difference between Shabbat candles and taper candles?",
            "subheading_tag": "h3",
            "subheading_font_class": "fs-heading-6-base"
          }
        },
        "text_Uft4WG": {
          "type": "text",
          "settings": {
            "text": "<p>Shabbat candles are a specific category of <a href=\"https://kiscocandles.com/collections/taper-candles\"><span style=\"text-decoration:underline\">taper candles</span></a> designed for religious use, always unscented, in appropriate heights for standard holders, and made with burn performance in mind for the Friday night table. Not all taper candles are made to these standards.</p>",
            "text_font_class": "fs-body-75"
          }
        }
      },
