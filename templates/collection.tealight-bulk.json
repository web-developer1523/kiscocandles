        },
        "text_cVFhCr": {
          "type": "text",
          "settings": {
            "text": "<p>Delight in hours of luminosity with our tealights, designed to glow for <a href=\"https://kiscocandles.com/products/bolsius-unscented-white-tea-lights-value-pack-100-200-tealights-burn-time-3-5-hour?variant=40155489501293\" title=\"3.5 Hour Tealight Candle\">3.5</a>, <a href=\"https://kiscocandles.com/products/bolsius-unscented-white-tea-lights-value-pack-70-tealights-burn-time-6-hour?_pos=1&_psq=6+hour+te&_ss=e&_v=1.0&variant=40155489599597\" title=\"6 Hour Tealight Candle\">6</a>, <a href=\"https://kiscocandles.com/products/bolsius-unscented-white-tea-lights-value-pack-50-tealights-burn-time-8-hour?variant=40155489665133\" title=\"8 Hour Tealight Candle\">8</a> or <a href=\"https://kiscocandles.com/products/bolsius-unscented-white-tea-lights-in-clear-cup-set-of-16-tealights-burns-9-hour?variant=40155489796205\" title=\"9 Hour Tealight Candle\">9 hours</a>, depending on the style you choose. </p>",
            "text_font_class": "fs-body-75"
