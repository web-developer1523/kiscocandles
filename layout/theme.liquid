<!-- Start of SparkLayer core script-->
<script>
  window.sparkOptions = {
    siteId: "kiscocandles",
    platform: "shopify",
    rootUrl: {{ routes.root_url | json }},
    language: {{ request.locale.iso_code | json }},
    accountRedirect: {
      urlRegex: /\/account/g,
      goTo: {%- if customer.tags contains 'wholesale' -%}"/pages/wholesale-dashboard"{%- else -%}"/index"{%- endif -%},
    },
    display: {
      stock: {
        show: true, // set to true to show stock level display
        max: 50, // highest stock level to show
        last: 5, // last remaining stock
        low: 15, // low stock threshold
        last: true, // set to false to hide last stock message
      },
    },
    translations: {
  en: {
    "pdp.price.rrp": "Retail Price: ",
    "product-card.price.rrp": "Retail Price: ",
    "cart.price.rrp": "Retail Price: ",
  }
},  
    auth: {
      user: {{ customer.email | json }},
      token: {{ customer.metafields.sparklayer.authentication | json }},
    },

      async onReady(spark) {
          var cart = await spark.getCart();
          if (cart) {
            updateCartBubble(cart);
          }
        },
        onCartUpdate(cart) {
          updateCartBubble(cart);
        }

    
  };
   async function updateCartBubble(cart) {
        var nbItems = 0;
        if (cart.items.length) {
          for (let item of cart.items) {
            nbItems += parseInt(item.quantity);
          }
        }
      
        const bubbleSpan = document.querySelector('.cart-count-bubble span');
        const bubble = document.querySelector('.cart-count-bubble');
      
        if (nbItems) {
          bubbleSpan.textContent = nbItems;
          bubble.classList.remove('hidden');
          bubble.classList.add('show');
        } else {
          bubbleSpan.textContent = '';
          bubble.classList.remove('show');
          bubble.classList.add('hidden');
        }
      }
</script>
<script async src="https://cdn.sparklayer.io/spark.1.35.x.js"></script>
<!-- End of SparkLayer core script-->
